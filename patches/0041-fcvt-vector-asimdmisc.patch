 DEF_ISEL(SCVTF_ASIMDMISC_R_2D_FPSRSTATUS) = SCVTF_Vector64_FPSRStatus<VIi64v2, VIf64v2>;
 
+// FCVT{Z,N,P,M,A}{S,U}  <Vd>.<T>, <Vn>.<T> -- vector float to integer.
+//
+// The inverse of SCVTF_Vector above, element for element, and it borrows two
+// decisions from work already done rather than re-deriving them:
+//
+//   * saturation comes from `CheckedCast`, exactly as the scalar FCVTZ* forms
+//     get it. That is what gives ARM's out-of-range and NaN results, so the
+//     ONLY thing a rounding mode changes is the value handed to the cast;
+//   * the rounding helpers are the ones patches 0004/0011/0028 settled on.
+//     wasm rounds to nearest-even natively, so `std::nearbyint` under the
+//     default FE_TONEAREST is FCVTN's ties-to-even and `std::round` is FCVTA's
+//     ties-away. FCVTZ* needs no helper: a C++ float-to-integer conversion
+//     already truncates toward zero, which is what Z means.
+namespace {
+
+// DB, the destination ELEMENT type, is a separate template parameter rather
+// than deduced from `res[0]`: subscripting a vector yields an lvalue, so
+// `decltype` gives `int &` and CheckedCast will not bind it. Spelling it out
+// also puts the signedness at each DEF_ISEL, which is the easy thing to get
+// wrong here -- FCVTZS and FCVTZU differ in nothing else.
+#define MAKE_FCVT_VECTOR(name, round, elem_size) \
+  template <typename S, typename D, typename DB> \
+  DEF_SEM_T_STATE(name##_Vector##elem_size, S src) { \
+    auto srcv = FReadVI##elem_size(src); \
+    D res{}; \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(srcv); i++) { \
+      res[i] = CheckedCast<float##elem_size##_t, DB>(state, round(srcv[i])); \
+    } \
+    return res; \
+  } \
+  template <typename S, typename D, typename DB> \
+  DEF_SEM_T_STATE(name##_Vector##elem_size##_FPSRStatus, S src) { \
+    auto srcv = FReadVI##elem_size(src); \
+    D res{}; \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(srcv); i++) { \
+      res[i] = CheckedCastFPSRStatus<float##elem_size##_t, DB>(state, round(srcv[i])); \
+    } \
+    return res; \
+  }
+
+// Round toward zero: no pre-rounding, the cast itself truncates.
+template <typename T>
+ALWAYS_INLINE static T FCVT_Trunc(T v) {
+  return v;
+}
+
+MAKE_FCVT_VECTOR(FCVTZ, FCVT_Trunc, 32)
+MAKE_FCVT_VECTOR(FCVTZ, FCVT_Trunc, 64)
+MAKE_FCVT_VECTOR(FCVTN, std::nearbyint, 32)
+MAKE_FCVT_VECTOR(FCVTN, std::nearbyint, 64)
+MAKE_FCVT_VECTOR(FCVTP, std::ceil, 32)
+MAKE_FCVT_VECTOR(FCVTP, std::ceil, 64)
+MAKE_FCVT_VECTOR(FCVTM, std::floor, 32)
+MAKE_FCVT_VECTOR(FCVTM, std::floor, 64)
+MAKE_FCVT_VECTOR(FCVTA, std::round, 32)
+MAKE_FCVT_VECTOR(FCVTA, std::round, 64)
+
+#undef MAKE_FCVT_VECTOR
+
+}  // namespace
