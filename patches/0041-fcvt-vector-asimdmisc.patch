+// FCVT{Z,N,P,M,A}{S,U}  <Vd>.<T>, <Vn>.<T> -- the VECTOR (ASIMD two-register
+// misc) float-to-integer conversions. Patch 0028 covered the scalar family
+// only; `fcvtzs v30.2s, v30.2s` inside libicuuc stopped initdb's post-bootstrap
+// phase, and the whole postgres closure holds only a handful of these, all
+// first reached once ICU executes -- so the family goes in together rather than
+// one 70-minute re-lift at a time.
+//
+// Operands are exactly SCVTF_ASIMDMISC_R's: one arrangement, the same register
+// class for source and destination (a 2S float vector converts to a 2S integer
+// vector). Only the ELEMENT interpretation differs, and that lives in the
+// semantics. The `sz && !Q` rejection is the 1D arrangement, which is
+// unallocated -- 64-bit elements require Q=1.
+static bool TryDecodeFCVT_ASIMDMISC(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::State;
+  if (data.sz && !data.Q) {
+    return false;
+  }
+  const uint64_t total_size = data.Q ? 128 : 64;
+  const uint64_t elem_size = data.sz ? 64 : 32;
+  AddArrangementSpecifier(inst, total_size, elem_size);
+  auto rclass = ArrangementRegClass(total_size, elem_size);
+  AddRegOperand(inst, kActionWrite, rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rn);
+  if (inst.lift_config.float_exception_enabled) {
+    AddArrangementSpecifierFPSRStatus(inst);
+  }
+  return true;
+}
