diff --git a/backend/remill/lib/Arch/AArch64/Semantics/CONVERT.cpp b/backend/remill/lib/Arch/AArch64/Semantics/CONVERT.cpp
index 925c016..f0d2f21 100644
--- a/backend/remill/lib/Arch/AArch64/Semantics/CONVERT.cpp
+++ b/backend/remill/lib/Arch/AArch64/Semantics/CONVERT.cpp
@@ -27,18 +27,59 @@
 #include "remill/Arch/Runtime/Types.h"
 
 #include <cstdint>
+#include <limits>
 #include <math.h>
+#include <type_traits>
 
 namespace {
 
+// ARM's float-to-integer conversions SATURATE, and a `static_cast` does not:
+// out-of-range is undefined in C++, and what wasm actually produced for
+// (int32_t) 1e30f was 0x80000000 -- so `fcvtzs` on a large POSITIVE value
+// returned INT32_MIN where the hardware returns INT32_MAX. It went unnoticed
+// because the only out-of-range case anyone had tested was a negative input to
+// an unsigned form, which lands on the min side and happens to be right.
+// Caught by e2e/fcvtvec_test.go, which pins both ends against a native baseline.
+//
+// NaN converts to zero (FPToFixed's FPUnpack path). `v != v` rather than
+// std::isnan so this needs no <cmath>.
+template <typename S, typename D>
+ALWAYS_INLINE static D SaturatingFPToInt(S v) {
+  if (v != v) {
+    return static_cast<D>(0);
+  }
+  constexpr D lo = std::numeric_limits<D>::min();
+  constexpr D hi = std::numeric_limits<D>::max();
+  // Compared in the FLOAT domain, and `>=` is load-bearing: for the 64-bit
+  // destinations `hi` is not representable, so `static_cast<S>(hi)` rounds UP
+  // to 2^63 (or 2^64) and a `>` would let that exact value through to an
+  // undefined cast.
+  if (v <= static_cast<S>(lo)) {
+    return lo;
+  }
+  if (v >= static_cast<S>(hi)) {
+    return hi;
+  }
+  return static_cast<D>(v);
+}
+
+template <typename S, typename D>
+ALWAYS_INLINE static D CastOrSaturate(S v) {
+  if constexpr (std::is_floating_point<S>::value && std::is_integral<D>::value) {
+    return SaturatingFPToInt<S, D>(v);
+  } else {
+    return static_cast<D>(v);
+  }
+}
+
 template <typename S, typename D>
 ALWAYS_INLINE static D CheckedCastFPSRStatus(State &state, S src) {
-  return CheckedFloatUnaryOp(state, [](S v) { return static_cast<D>(v); }, src);
+  return CheckedFloatUnaryOp(state, [](S v) { return CastOrSaturate<S, D>(v); }, src);
 }
 
 template <typename S, typename D>
 ALWAYS_INLINE static D CheckedCast(State &state, S src) {
-  return static_cast<D>(src);
+  return CastOrSaturate<S, D>(src);
 }
 
