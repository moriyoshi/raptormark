@@ -17212,8 +17212,13 @@ bool TryDecodeFMULX_ASIMDELEM_R_SD(const InstData &, Instruction &) {
 //  30 1 size     0
 //  31 1 size     1
 // PRFM  (<prfop>|#<imm5>), [<Xn|SP>, (<Wm>|<Xm>){, <extend> {<amount>}}]
-bool TryDecodePRFM_P_LDST_REGOFF(const InstData &, Instruction &) {
-  return false;
+bool TryDecodePRFM_P_LDST_REGOFF(const InstData &, Instruction &inst) {
+  // PRFM is a pure cache hint with no architectural effect: decode as a NOP,
+  // mirroring TryDecodePRFM_P_LDST_POS (Arch.cpp). Leaving it undecoded makes
+  // the instruction unlifted, so reaching it traps with
+  // "no lifted instruction at 0x... was executed".
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  return true;
 }
 
