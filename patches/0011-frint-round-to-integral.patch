+ECV_ISEL_FRINT(FRINTN, S)
+ECV_ISEL_FRINT(FRINTN, D)
+ECV_ISEL_FRINT(FRINTI, S)
+ECV_ISEL_FRINT(FRINTI, D)
+ECV_ISEL_FRINT(FRINTA, S)
+#undef ECV_ISEL_FRINT
