+// raptormark: scalar FRINT{P,Z,N,I} and FRINTA_S round-to-integral. The pinned
+// remill decoder stubs these to `return false` (FRINTM/FRINTA_D are upstream,
+// FRINTX is patch 0004); an undecoded one becomes an inline __ecv_warning -> fatal
+// when executed (hit e.g. as FRINTP in the query planner's btcostestimate cost
+// rounding). Decoding is identical to FRINTM; only the semantic rounding differs.
+#define ECV_DECODE_FRINT_SD(NAME) \
+  bool TryDecode##NAME##_S_FLOATDP1(const InstData &data, Instruction &inst) { \
+    inst.sema_func_arg_type = SemaFuncArgType::State; \
+    AddRegOperand(inst, kActionWrite, kRegS, kUseAsValue, data.Rd); \
+    AddRegOperand(inst, kActionRead, kRegS, kUseAsValue, data.Rn); \
+    if (inst.lift_config.float_exception_enabled) { \
+      AddArrangementSpecifierFPSRStatus(inst); \
+    } \
+    return true; \
+  } \
+  bool TryDecode##NAME##_D_FLOATDP1(const InstData &data, Instruction &inst) { \
+    inst.sema_func_arg_type = SemaFuncArgType::State; \
+    AddRegOperand(inst, kActionWrite, kRegD, kUseAsValue, data.Rd); \
+    AddRegOperand(inst, kActionRead, kRegD, kUseAsValue, data.Rn); \
+    if (inst.lift_config.float_exception_enabled) { \
+      AddArrangementSpecifierFPSRStatus(inst); \
+    } \
+    return true; \
+  }
+ECV_DECODE_FRINT_SD(FRINTP)
+ECV_DECODE_FRINT_SD(FRINTZ)
+ECV_DECODE_FRINT_SD(FRINTN)
+ECV_DECODE_FRINT_SD(FRINTI)
+#undef ECV_DECODE_FRINT_SD
+// FRINTA_D is upstream; only the S form is stubbed.
+bool TryDecodeFRINTA_S_FLOATDP1(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::State;
+  AddRegOperand(inst, kActionWrite, kRegS, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegS, kUseAsValue, data.Rn);
+  if (inst.lift_config.float_exception_enabled) {
+    AddArrangementSpecifierFPSRStatus(inst);
+  }
+  return true;
+}
