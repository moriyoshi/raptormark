+// raptormark: scalar FRINT{P,Z,N,I} (S/D) + FRINTA_S round-to-integral. Modeled on
+// FRINTM (std::floor). WASM has round-to-nearest only, so ties-to-even (FRINTN/I)
+// use std::nearbyint (default FE_TONEAREST) and FRINTA uses std::round (ties away).
+namespace {
+DEF_SEM_F32_STATE(FRINTP_S, RF32 src) { return std::ceil(Read(src)); }
+DEF_SEM_F64_STATE(FRINTP_D, RF64 src) { return std::ceil(Read(src)); }
+DEF_SEM_F32_STATE(FRINTZ_S, RF32 src) { return std::trunc(Read(src)); }
+DEF_SEM_F64_STATE(FRINTZ_D, RF64 src) { return std::trunc(Read(src)); }
+DEF_SEM_F32_STATE(FRINTN_S, RF32 src) { return std::nearbyint(Read(src)); }
+DEF_SEM_F64_STATE(FRINTN_D, RF64 src) { return std::nearbyint(Read(src)); }
+DEF_SEM_F32_STATE(FRINTI_S, RF32 src) { return std::nearbyint(Read(src)); }
+DEF_SEM_F64_STATE(FRINTI_D, RF64 src) { return std::nearbyint(Read(src)); }
+DEF_SEM_F32_STATE(FRINTA_S, RF32 src) { return std::round(Read(src)); }
+}  // namespace
+#define ECV_ISEL_FRINT(NAME, T) \
+  DEF_ISEL(NAME##_##T##_FLOATDP1) = NAME##_##T; \
+  DEF_ISEL(NAME##_##T##_FLOATDP1_FPSRSTATUS) = NAME##_##T;
+ECV_ISEL_FRINT(FRINTP, S)
