diff --git a/backend/remill/lib/Arch/AArch64/Decode.cpp b/backend/remill/lib/Arch/AArch64/Decode.cpp
index e69f392..0df1cfe 100644
--- a/backend/remill/lib/Arch/AArch64/Decode.cpp
+++ b/backend/remill/lib/Arch/AArch64/Decode.cpp
@@ -15351,8 +15351,11 @@ bool TryDecodeFMLA_ASIMDSAMEFP16_ONLY(const InstData &, Instruction &) {
 //  30 0 op54     1
 //  31 1 sf       0
 // SMNEGL  <Xd>, <Wn>, <Wm>
-bool TryDecodeSMNEGL_SMSUBL_64WA_DP_3SRC(const InstData &, Instruction &) {
-  return false;
+bool TryDecodeSMNEGL_SMSUBL_64WA_DP_3SRC(const InstData &data, Instruction &inst) {
+  // SMNEGL  <Xd>, <Wn>, <Wm>  ==  SMSUBL <Xd>, <Wn>, <Wm>, XZR. UMSUBL's decode
+  // reads Ra as an X reg; Ra==31 is XZR(0), so the SMSUBL semantics give -(Wn*Wm).
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  return TryDecodeUMSUBL_64WA_DP_3SRC(data, inst);
 }
 
 
@@ -30459,8 +30462,15 @@ bool TryDecodeSYSL_RC_SYSTEM(const InstData &, Instruction &) {
 //  30 0 op54     1
 //  31 1 sf       0
 // SMSUBL  <Xd>, <Wn>, <Wm>, <Xa>
-bool TryDecodeSMSUBL_64WA_DP_3SRC(const InstData &, Instruction &) {
-  return false;
+bool TryDecodeSMSUBL_64WA_DP_3SRC(const InstData &data, Instruction &inst) {
+  // SMSUBL  <Xd>, <Wn>, <Wm>, <Xa>  -- signed multiply-subtract long. Same operand
+  // layout as UMSUBL (Xd<-Rd, Wn<-Rn, Wm<-Rm, Xa<-Ra); only the lifting semantics
+  // differ (signed). The pinned remill left this a `return false` stub, so the
+  // lifter silently dropped the instruction and its basic block, surfacing as an
+  // "__ecv_warning: no lifted instruction" abort in OpenSSL's OBJ_obj2txt (OID arc
+  // encoding: first_arc -= 40). See raptormark patches/0009.
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  return TryDecodeUMSUBL_64WA_DP_3SRC(data, inst);
 }
 
