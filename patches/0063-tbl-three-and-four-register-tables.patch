diff --git a/backend/remill/lib/Arch/AArch64/Arch.cpp b/backend/remill/lib/Arch/AArch64/Arch.cpp
index 51da5e6..a1482c8 100644
--- a/backend/remill/lib/Arch/AArch64/Arch.cpp
+++ b/backend/remill/lib/Arch/AArch64/Arch.cpp
@@ -3795,6 +3795,21 @@ bool TryDecodeTBL_ASIMDTBL_L1_1(const InstData &data, Instruction &inst) {
   return true;
 }
 
+// raptormark: the table registers of TBL/TBX are consecutive MODULO 32 --
+// "the register number is incremented and wrapped within the range 0 to 31"
+// (ARM ARM, TBL). Without the wrap a table starting at V30 or V31 asks for
+// register 32, which is not a register.
+//
+// No site in the measured corpus wraps (the 706 TBL sites start at V16/V20/V24/
+// V28), so this is not a fix for anything observed -- it is the difference
+// between implementing the instruction and implementing the cases that happened
+// to turn up. `TryDecodeTBL_ASIMDTBL_L2_2` below is switched onto it too; it had
+// the same latent out-of-range operand for Rn=31.
+static aarch64::RegNum WrapVReg(aarch64::RegNum rn, unsigned add) {
+  using U = std::underlying_type<aarch64::RegNum>::type;
+  return static_cast<aarch64::RegNum>((static_cast<U>(rn) + add) % 32);
+}
+
 // TBL  <Vd>.<Ta>, { <Vn>.16B, <Vn+1>.16B }, <Vm>.<Ta>
 bool TryDecodeTBL_ASIMDTBL_L2_2(const InstData &data, Instruction &inst) {
   inst.sema_func_arg_type = SemaFuncArgType::Nothing;
@@ -3803,9 +3818,39 @@ bool TryDecodeTBL_ASIMDTBL_L2_2(const InstData &data, Instruction &inst) {
   AddArrangementSpecifier(inst, ta_total_size, 8);
   AddRegOperand(inst, kActionWrite, ta_rclass, kUseAsValue, data.Rd);
   AddRegOperand(inst, kActionRead, kReg16B, kUseAsValue, data.Rn);
-  aarch64::RegNum rn_plus_1 =
-      static_cast<aarch64::RegNum>(std::underlying_type<aarch64::RegNum>::type(data.Rn) + 1);
-  AddRegOperand(inst, kActionRead, kReg16B, kUseAsValue, rn_plus_1);
+  AddRegOperand(inst, kActionRead, kReg16B, kUseAsValue, WrapVReg(data.Rn, 1));
+  AddRegOperand(inst, kActionRead, ta_rclass, kUseAsValue, data.Rm);
+  return true;
+}
+
+// TBL  <Vd>.<Ta>, { <Vn>.16B, <Vn+1>.16B, <Vn+2>.16B }, <Vm>.<Ta>
+bool TryDecodeTBL_ASIMDTBL_L3_3(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  auto ta_rclass = data.Q ? kReg16B : kReg8B;
+  auto ta_total_size = data.Q ? 128 : 64;
+  AddArrangementSpecifier(inst, ta_total_size, 8);
+  AddRegOperand(inst, kActionWrite, ta_rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kReg16B, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kReg16B, kUseAsValue, WrapVReg(data.Rn, 1));
+  AddRegOperand(inst, kActionRead, kReg16B, kUseAsValue, WrapVReg(data.Rn, 2));
+  AddRegOperand(inst, kActionRead, ta_rclass, kUseAsValue, data.Rm);
+  return true;
+}
+
+// TBL  <Vd>.<Ta>, { <Vn>.16B, <Vn+1>.16B, <Vn+2>.16B, <Vn+3>.16B }, <Vm>.<Ta>
+//
+// This is the form that matters: an `[ecv-undecoded]` inventory of the postgres
+// closure (2026-08-19) found 706 TBL sites and ALL 706 are this one, 16B.
+bool TryDecodeTBL_ASIMDTBL_L4_4(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  auto ta_rclass = data.Q ? kReg16B : kReg8B;
+  auto ta_total_size = data.Q ? 128 : 64;
+  AddArrangementSpecifier(inst, ta_total_size, 8);
+  AddRegOperand(inst, kActionWrite, ta_rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kReg16B, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kReg16B, kUseAsValue, WrapVReg(data.Rn, 1));
+  AddRegOperand(inst, kActionRead, kReg16B, kUseAsValue, WrapVReg(data.Rn, 2));
+  AddRegOperand(inst, kActionRead, kReg16B, kUseAsValue, WrapVReg(data.Rn, 3));
   AddRegOperand(inst, kActionRead, ta_rclass, kUseAsValue, data.Rm);
   return true;
 }
