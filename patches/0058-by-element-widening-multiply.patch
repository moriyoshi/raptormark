+// {S,U}MLAL{2} / {S,U}MLSL{2} / {S,U}MULL{2}
+//   <Vd>.<Ta>, <Vn>.<Tb>, <Vm>.<Ts>[<index>]  -- the BY-ELEMENT widening
+// multiplies, where the multiplier is one lane of Vm broadcast across the
+// operation.
+//
+// Patch 0051 implemented the ASIMDDIFF register-register forms and described
+// itself as covering "the widening multiply family". It did not: these are a
+// separate encoding class with a separate decoder, and the crypto image has 557
+// undecodable sites of `umlal <Vd>.2d, <Vn>.2s, <Vm>.s[i]` alone. Found by the
+// lift-time report of patch 0057, not by a guest dying on one.
+//
+// Two things differ from every other by-element decoder here:
+//
+//   - the ELEMENT register is read as a FULL 128-bit view regardless of Q,
+//     because the index addresses the whole register. `umlal v13.2d, v29.2s,
+//     v3.s[3]` is real code from libcrypto: a 64-bit source arrangement naming
+//     lane 3 of the element register. `ByElementIndexFits` must therefore NOT
+//     be applied -- it exists for the same-arrangement FP forms, where a 64-bit
+//     view genuinely cannot reach lanes 2 and 3.
+//   - how the index and the element register split the M bit depends on SIZE.
+//     For 16-bit elements the index is H:L:M and the register is the bare 4-bit
+//     Rm; for 32-bit elements the index is H:L and the register is M:Rm. Using
+//     one rule for both silently reads the wrong register for V16-V31 -- the
+//     exact defect patch 0045 documents.
+static bool TryDecodeMLXL_ASIMDELEM(const InstData &data, Instruction &inst, bool accumulate) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  int index;
+  uint64_t s_esize;
+  aarch64::RegNum elem_reg;
+  if (0b01 == data.size) {
+    s_esize = 16;
+    index = (static_cast<int>(data.H) << 2) | (static_cast<int>(data.L) << 1) |
+            static_cast<int>(data.M);
+    elem_reg = static_cast<aarch64::RegNum>(data.Rm);  // M is part of the index here
+  } else if (0b10 == data.size) {
+    s_esize = 32;
+    index = (static_cast<int>(data.H) << 1) | static_cast<int>(data.L);
+    elem_reg = ByElementRegNum(data);  // M:Rm -- see ByElementRegNum
+  } else {
+    return false;  // size 00 and 11 are unallocated for the widening forms
+  }
+  const uint64_t d_esize = s_esize * 2;
+  const uint64_t s_tsize = data.Q ? 128 : 64;
+  AddArrangementSpecifierUSHLL(inst, 128, d_esize, s_tsize, s_esize);
+  auto d_rclass = ArrangementRegClass(128, d_esize);
+  auto s_rclass = ArrangementRegClass(s_tsize, s_esize);
+  auto e_rclass = ArrangementRegClass(128, s_esize);
+  AddRegOperand(inst, accumulate ? kActionReadWrite : kActionWrite, d_rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, s_rclass, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, e_rclass, kUseAsValue, elem_reg);
+  AddImmOperand(inst, index, kUnsigned, 32);
+  return true;
+}
+
+bool TryDecodeUMLAL_ASIMDELEM_L(const InstData &data, Instruction &inst) {
+  return TryDecodeMLXL_ASIMDELEM(data, inst, true);
+}
+
+bool TryDecodeUMLSL_ASIMDELEM_L(const InstData &data, Instruction &inst) {
+  return TryDecodeMLXL_ASIMDELEM(data, inst, true);
+}
+
+bool TryDecodeSMLAL_ASIMDELEM_L(const InstData &data, Instruction &inst) {
+  return TryDecodeMLXL_ASIMDELEM(data, inst, true);
+}
+
+bool TryDecodeSMLSL_ASIMDELEM_L(const InstData &data, Instruction &inst) {
+  return TryDecodeMLXL_ASIMDELEM(data, inst, true);
+}
+
+bool TryDecodeUMULL_ASIMDELEM_L(const InstData &data, Instruction &inst) {
+  return TryDecodeMLXL_ASIMDELEM(data, inst, false);
+}
+
+bool TryDecodeSMULL_ASIMDELEM_L(const InstData &data, Instruction &inst) {
+  return TryDecodeMLXL_ASIMDELEM(data, inst, false);
+}
