+// The BY-ELEMENT widening multiplies: one lane of the element register is the
+// multiplier for every lane of the operation.
+//
+// Widened BEFORE the multiply, same as MAKE_MULL above and for the same reason.
+// The element operand is a full 128-bit vector, so `idx` may legitimately reach
+// lanes the SOURCE arrangement does not have -- see the decoder.
+#define ECV_MAKE_MLXL_ELEM(name, rd, ty, op, s_esize, d_esize) \
+  template <typename D, typename S, typename E> \
+  DEF_SEM_T(name##_##s_esize, D dst, S srcn, E srcm, I32 imm) { \
+    auto idx = Read(imm); \
+    auto srcn_v = rd##ReadVI##s_esize(srcn); \
+    auto srcm_v = rd##ReadVI##s_esize(srcm); \
+    auto m = ty##d_esize##_t(srcm_v[idx]); \
+    D res = rd##ReadVI##d_esize(dst); \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(res); i++) { \
+      res[i] op ty##d_esize##_t(srcn_v[i]) * m; \
+    } \
+    return res; \
+  } \
+  template <typename D, typename S, typename E> \
+  DEF_SEM_T(name##2_##s_esize, D dst, S srcn, E srcm, I32 imm) { \
+    auto idx = Read(imm); \
+    auto srcn_v = rd##ReadVI##s_esize(srcn); \
+    auto srcm_v = rd##ReadVI##s_esize(srcm); \
+    auto m = ty##d_esize##_t(srcm_v[idx]); \
+    D res = rd##ReadVI##d_esize(dst); \
+    auto res_len = GetVectorElemsNum(res); \
+    _Pragma("unroll") for (size_t i = 0; i < res_len; i++) { \
+      res[i] op ty##d_esize##_t(srcn_v[i + res_len]) * m; \
+    } \
+    return res; \
+  }
+
+// MULL overwrites rather than accumulating, so its destination is not read.
+#define ECV_MAKE_MULL_ELEM(name, rd, ty, s_esize, d_esize) \
+  template <typename D, typename S, typename E> \
+  DEF_SEM_T(name##_##s_esize, S srcn, E srcm, I32 imm) { \
+    auto idx = Read(imm); \
+    auto srcn_v = rd##ReadVI##s_esize(srcn); \
+    auto srcm_v = rd##ReadVI##s_esize(srcm); \
+    auto m = ty##d_esize##_t(srcm_v[idx]); \
+    D res{}; \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(res); i++) { \
+      res[i] = ty##d_esize##_t(srcn_v[i]) * m; \
+    } \
+    return res; \
+  } \
+  template <typename D, typename S, typename E> \
+  DEF_SEM_T(name##2_##s_esize, S srcn, E srcm, I32 imm) { \
+    auto idx = Read(imm); \
+    auto srcn_v = rd##ReadVI##s_esize(srcn); \
+    auto srcm_v = rd##ReadVI##s_esize(srcm); \
+    auto m = ty##d_esize##_t(srcm_v[idx]); \
+    D res{}; \
+    auto res_len = GetVectorElemsNum(res); \
+    _Pragma("unroll") for (size_t i = 0; i < res_len; i++) { \
+      res[i] = ty##d_esize##_t(srcn_v[i + res_len]) * m; \
+    } \
+    return res; \
+  }
+
+ECV_MAKE_MLXL_ELEM(UMLALE, U, uint, +=, 16, 32)
+ECV_MAKE_MLXL_ELEM(UMLALE, U, uint, +=, 32, 64)
+ECV_MAKE_MLXL_ELEM(UMLSLE, U, uint, -=, 16, 32)
+ECV_MAKE_MLXL_ELEM(UMLSLE, U, uint, -=, 32, 64)
+ECV_MAKE_MLXL_ELEM(SMLALE, S, int, +=, 16, 32)
+ECV_MAKE_MLXL_ELEM(SMLALE, S, int, +=, 32, 64)
+ECV_MAKE_MLXL_ELEM(SMLSLE, S, int, -=, 16, 32)
+ECV_MAKE_MLXL_ELEM(SMLSLE, S, int, -=, 32, 64)
+ECV_MAKE_MULL_ELEM(UMULLE, U, uint, 16, 32)
