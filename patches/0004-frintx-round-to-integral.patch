+// FRINTX  <Sd>, <Sn> / <Dd>, <Dn>
+// Round to integral using the CURRENT rounding mode (FPCR.RMode; default RN =
+// round-to-nearest, ties-to-EVEN) -- which is std::rint, not std::round and not
+// FRINTA's ties-away-from-zero. WebAssembly's FP is always round-to-nearest
+// ties-to-even, matching the ARM default, so this lowers exactly.
+namespace {
+DEF_SEM_F32_STATE(FRINTX_S, RF32 src) {
+  return std::rint(Read(src));
+}
+DEF_SEM_F64_STATE(FRINTX_D, RF64 src) {
+  return std::rint(Read(src));
+}
+}  // namespace
+
+DEF_ISEL(FRINTX_S_FLOATDP1) = FRINTX_S;
+DEF_ISEL(FRINTX_S_FLOATDP1_FPSRSTATUS) = FRINTX_S;
+DEF_ISEL(FRINTX_D_FLOATDP1) = FRINTX_D;
+DEF_ISEL(FRINTX_D_FLOATDP1_FPSRSTATUS) = FRINTX_D;
