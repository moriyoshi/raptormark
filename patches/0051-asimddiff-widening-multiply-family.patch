+// The rest of the ASIMDDIFF widening-multiply family, which SMLAL{2} left
+// behind. They share SMLAL's operand shape exactly -- two narrow source
+// vectors, one wide destination, the `2` variant selecting the high half via
+// data.Q -- and differ only in signedness and in whether the destination
+// accumulates. The decoder therefore differs in one thing: MULL WRITES its
+// destination, MLAL/MLSL READ-WRITE it.
+//
+// They come as a group because autovectorized code emits them as a group:
+// redis's lifted image stopped at a `umull v18.4s, v17.4h, v30.4h` sitting one
+// instruction away from a `umull2`, both inside a loop that already decoded its
+// `uaddw`/`uaddw2` neighbours.
+
+// UMULL{2}  <Vd>.<Ta>, <Vn>.<Tb>, <Vm>.<Tb>  -- unsigned multiply long.
+bool TryDecodeUMULL_ASIMDDIFF_L(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  if (data.size == 0b11) {
+    return false;
+  }
+  uint64_t d_tsize, s_tsize, d_esize, s_esize;
+  d_tsize = 128;
+  s_tsize = data.Q ? 128 : 64;
+  d_esize = 16 << data.size;
+  s_esize = 8 << data.size;
+  AddArrangementSpecifierUSHLL(inst, d_tsize, d_esize, s_tsize, s_esize);
+  auto d_rclass = ArrangementRegClass(d_tsize, d_esize);
+  auto s_rclass = ArrangementRegClass(s_tsize, s_esize);
+  AddRegOperand(inst, kActionWrite, d_rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, s_rclass, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, s_rclass, kUseAsValue, data.Rm);
+  return true;
+}
+
+// SMULL{2}  <Vd>.<Ta>, <Vn>.<Tb>, <Vm>.<Tb>  -- signed multiply long.
+bool TryDecodeSMULL_ASIMDDIFF_L(const InstData &data, Instruction &inst) {
+  return TryDecodeUMULL_ASIMDDIFF_L(data, inst);
+}
+
+// UMLAL{2}  <Vd>.<Ta>, <Vn>.<Tb>, <Vm>.<Tb>  -- unsigned multiply-accumulate.
+bool TryDecodeUMLAL_ASIMDDIFF_L(const InstData &data, Instruction &inst) {
+  return TryDecodeSMLAL_ASIMDDIFF_L(data, inst);
+}
+
+// UMLSL{2}  <Vd>.<Ta>, <Vn>.<Tb>, <Vm>.<Tb>  -- unsigned multiply-subtract.
+bool TryDecodeUMLSL_ASIMDDIFF_L(const InstData &data, Instruction &inst) {
+  return TryDecodeSMLAL_ASIMDDIFF_L(data, inst);
+}
+
+// SMLSL{2}  <Vd>.<Ta>, <Vn>.<Tb>, <Vm>.<Tb>  -- signed multiply-subtract.
+bool TryDecodeSMLSL_ASIMDDIFF_L(const InstData &data, Instruction &inst) {
+  return TryDecodeSMLAL_ASIMDDIFF_L(data, inst);
+}
