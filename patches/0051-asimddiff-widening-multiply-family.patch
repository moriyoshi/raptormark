diff --git a/backend/remill/lib/Arch/AArch64/Semantics/SIMD.cpp b/backend/remill/lib/Arch/AArch64/Semantics/SIMD.cpp
index 0d69f81..9693376 100644
--- a/backend/remill/lib/Arch/AArch64/Semantics/SIMD.cpp
+++ b/backend/remill/lib/Arch/AArch64/Semantics/SIMD.cpp
@@ -2263,6 +2263,123 @@ DEF_ISEL(SMLAL_ASIMDDIFF_L_8H16B) = SMLAL2_8<VIi16v8, VIi8v16>;
 DEF_ISEL(SMLAL_ASIMDDIFF_L_4S8H) = SMLAL2_16<VIi32v4, VIi16v8>;
 DEF_ISEL(SMLAL_ASIMDDIFF_L_2D4S) = SMLAL2_32<VIi64v2, VIi32v4>;
 
+// The rest of the ASIMDDIFF widening-multiply family: {S,U}MULL{2},
+// UMLAL{2}, {S,U}MLSL{2}. Same widening shape as SMLAL -- narrow sources,
+// destination twice the element width, the `2` form reading the high half --
+// differing only in signedness and in what is done with the product.
+//
+// The product is computed in the WIDE type, so the widening conversion happens
+// before the multiply. Doing it the other way truncates: 0xffff * 0xffff is
+// 0xfffe0001, which is exactly the value a 4H*4H->4S umull must produce and
+// exactly the value a 16-bit multiply cannot hold.
+namespace {
+
+// MULL: dst = widen(n) * widen(m). Write-only destination.
+#define MAKE_MULL(name, rd, ty, s_esize, d_esize) \
+  template <typename D, typename S> \
+  DEF_SEM_T(name##_##s_esize, S srcn, S srcm) { \
+    auto srcn_v = rd##ReadVI##s_esize(srcn); \
+    auto srcm_v = rd##ReadVI##s_esize(srcm); \
+    D res{}; \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(res); i++) { \
+      res[i] = ty##d_esize##_t(srcn_v[i]) * ty##d_esize##_t(srcm_v[i]); \
+    } \
+    return res; \
+  } \
+  template <typename D, typename S> \
+  DEF_SEM_T(name##2_##s_esize, S srcn, S srcm) { \
+    auto srcn_v = rd##ReadVI##s_esize(srcn); \
+    auto srcm_v = rd##ReadVI##s_esize(srcm); \
+    D res{}; \
+    auto res_len = GetVectorElemsNum(res); \
+    _Pragma("unroll") for (size_t i = 0; i < res_len; i++) { \
+      res[i] = ty##d_esize##_t(srcn_v[i + res_len]) * ty##d_esize##_t(srcm_v[i + res_len]); \
+    } \
+    return res; \
+  }
+
+// MLAL/MLSL: dst op= widen(n) * widen(m). Read-write destination, matching the
+// kActionReadWrite operand the decoder adds.
+#define MAKE_MLXL(name, rd, ty, op, s_esize, d_esize) \
+  template <typename D, typename S> \
+  DEF_SEM_T(name##_##s_esize, D dst, S srcn, S srcm) { \
+    auto srcn_v = rd##ReadVI##s_esize(srcn); \
+    auto srcm_v = rd##ReadVI##s_esize(srcm); \
+    D res = rd##ReadVI##d_esize(dst); \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(res); i++) { \
+      res[i] op ty##d_esize##_t(srcn_v[i]) * ty##d_esize##_t(srcm_v[i]); \
+    } \
+    return res; \
+  } \
+  template <typename D, typename S> \
+  DEF_SEM_T(name##2_##s_esize, D dst, S srcn, S srcm) { \
+    auto srcn_v = rd##ReadVI##s_esize(srcn); \
+    auto srcm_v = rd##ReadVI##s_esize(srcm); \
+    D res = rd##ReadVI##d_esize(dst); \
+    auto res_len = GetVectorElemsNum(res); \
+    _Pragma("unroll") for (size_t i = 0; i < res_len; i++) { \
+      res[i] op ty##d_esize##_t(srcn_v[i + res_len]) * ty##d_esize##_t(srcm_v[i + res_len]); \
+    } \
+    return res; \
+  }
+
+MAKE_MULL(UMULL, U, uint, 8, 16);
+MAKE_MULL(UMULL, U, uint, 16, 32);
+MAKE_MULL(UMULL, U, uint, 32, 64);
+MAKE_MULL(SMULL, S, int, 8, 16);
+MAKE_MULL(SMULL, S, int, 16, 32);
+MAKE_MULL(SMULL, S, int, 32, 64);
+
+MAKE_MLXL(UMLAL, U, uint, +=, 8, 16);
+MAKE_MLXL(UMLAL, U, uint, +=, 16, 32);
+MAKE_MLXL(UMLAL, U, uint, +=, 32, 64);
+MAKE_MLXL(UMLSL, U, uint, -=, 8, 16);
+MAKE_MLXL(UMLSL, U, uint, -=, 16, 32);
+MAKE_MLXL(UMLSL, U, uint, -=, 32, 64);
+MAKE_MLXL(SMLSL, S, int, -=, 8, 16);
+MAKE_MLXL(SMLSL, S, int, -=, 16, 32);
+MAKE_MLXL(SMLSL, S, int, -=, 32, 64);
+
+#undef MAKE_MULL
+#undef MAKE_MLXL
+
+}  // namespace
