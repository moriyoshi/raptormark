 // The abcdefgh imm8 expands to an IEEE-754 double via VFPExpandImmToFloat64
 // (returns the raw 64-bit pattern); both D lanes get that value, which is exactly
 // the MOVI_D2 (I64 replicate) semantic reused here.
+// FMOV  <Vd>.<T>, #<imm>   (T = 2S or 4S)
+//
+// The single-precision sibling of FMOV_ASIMDIMM_D2_D below, which patch 0010
+// added. `fmov v1.2s, #1.0` is what a compiler emits for `v2f x = {1.0f, 1.0f}`,
+// and this being a stub killed a test guest before any of its checks ran.
+//
+// The operand shape is MOVI_ASIMDIMM_L_SL's exactly -- an arrangement specifier,
+// a written vector register, and one 32-bit immediate -- so it reuses MOVI_L_SL
+// as its semantics and needs no new DEF_SEM.
+//
+// ❗ THE IMMEDIATE IS ConcatABCDEFGHToU8(data), NOT data.imm8.uimm. `imm8` is the
+// SCALAR FMOV field; the vector ASIMDIMM format splits abcdefgh across bits
+// [18:16] and [9:5], which is what every other ASIMDIMM decoder in this file
+// reads. The first version of this patch copied `data.imm8.uimm` from the D2_D
+// form below: it DECODED cleanly and produced 2.0 for `fmov v1.2s, #1.0` -- a
+// silently wrong constant, caught only by running a guest and diffing against
+// the native result.
+bool TryDecodeFMOV_ASIMDIMM_S_S(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  AddQArrangementSpecifier(data, inst, "4S", "2S");
+  AddRegOperand(inst, kActionWrite, data.Q ? kReg4S : kReg2S, kUseAsValue, data.Rd);
+  AddImmOperand(inst, VFPExpandImmToFloat32(ConcatABCDEFGHToU8(data)), kUnsigned, 32);
+  return true;
+}
+
