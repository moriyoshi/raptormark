 DEF_ISEL(MOVI_ASIMDIMM_D2_D) = MOVI_D2;  // MOVI  <Vd>.2D, #<imm>
 // FMOV <Vd>.2D, #<imm>: the decoder (Arch.cpp) expands the imm8 to the double's
