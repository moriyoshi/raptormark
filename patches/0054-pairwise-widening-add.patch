     return res; \
   }
 
+// {S,U}ADDLP / {S,U}ADALP: pairwise add of ADJACENT source lanes, widened.
+//
+// Destination lane i is source lanes 2i and 2i+1 summed at DOUBLE width, so the
+// widening happens before the add and the sum cannot overflow the source type.
+// Widening after would be the same bug patch 0051 documents for the multiplies,
+// and it is invisible for the popcount idiom that brought this in (byte counts
+// max out at 8) -- which is exactly why the guard has to use inputs that
+// saturate the narrow type.
+//
+// ADALP accumulates into the destination; ADDLP overwrites it.
+#define ECV_MAKE_ADDLP(name, rd, ty, s_esize, d_esize) \
+  template <typename D, typename S> \
+  DEF_SEM_T(name##_##s_esize, S srcn) { \
+    auto srcn_v = rd##ReadVI##s_esize(srcn); \
+    D res{}; \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(res); i++) { \
+      res[i] = ty##d_esize##_t(srcn_v[2 * i]) + ty##d_esize##_t(srcn_v[2 * i + 1]); \
+    } \
+    return res; \
+  }
+
+#define ECV_MAKE_ADALP(name, rd, ty, s_esize, d_esize) \
+  template <typename D, typename S> \
+  DEF_SEM_T(name##_##s_esize, D dst, S srcn) { \
+    auto srcn_v = rd##ReadVI##s_esize(srcn); \
+    D res = rd##ReadVI##d_esize(dst); \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(res); i++) { \
+      res[i] += ty##d_esize##_t(srcn_v[2 * i]) + ty##d_esize##_t(srcn_v[2 * i + 1]); \
+    } \
+    return res; \
+  }
+
+ECV_MAKE_ADDLP(UADDLP, U, uint, 8, 16);
+ECV_MAKE_ADDLP(UADDLP, U, uint, 16, 32);
+ECV_MAKE_ADDLP(UADDLP, U, uint, 32, 64);
+ECV_MAKE_ADDLP(SADDLP, S, int, 8, 16);
+ECV_MAKE_ADDLP(SADDLP, S, int, 16, 32);
+ECV_MAKE_ADDLP(SADDLP, S, int, 32, 64);
+ECV_MAKE_ADALP(UADALP, U, uint, 8, 16);
+ECV_MAKE_ADALP(UADALP, U, uint, 16, 32);
+ECV_MAKE_ADALP(UADALP, U, uint, 32, 64);
+ECV_MAKE_ADALP(SADALP, S, int, 8, 16);
+ECV_MAKE_ADALP(SADALP, S, int, 16, 32);
+ECV_MAKE_ADALP(SADALP, S, int, 32, 64);
+
+#undef ECV_MAKE_ADDLP
+#undef ECV_MAKE_ADALP
+
