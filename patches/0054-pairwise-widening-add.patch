+// {S,U}ADDLP / {S,U}ADALP  <Vd>.<Ta>, <Vn>.<Tb> -- pairwise add of ADJACENT
+// source elements, widened to twice the element size.
+//
+// All four were `return false` stubs. cryptography's Rust extension stops on
+// `uaddlp v0.8h, v0.16b`: it is the second half of the vector POPCOUNT idiom,
+// `cnt` (which is lifted) followed by two pairwise widening adds folding byte
+// counts up into halfwords and then words.
+//
+// The arrangement differs from the ASIMDDIFF family below: the destination has
+// the same TOTAL size as the source rather than always 128, because this halves
+// the lane count while doubling the lane width. `size == 0b11` is reserved.
+//
+// ADALP accumulates, so its destination is read-write; ADDLP overwrites. That
+// is the only difference between the two, and it is the one a copy-paste gets
+// wrong silently.
+static bool TryDecodeADDLP_ASIMDMISC(const InstData &data, Instruction &inst, bool accumulate) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  if (data.size == 0b11) {
+    return false;
+  }
+  const uint64_t tsize = data.Q ? 128 : 64;
+  const uint64_t s_esize = 8 << data.size;
+  const uint64_t d_esize = s_esize * 2;
+  AddArrangementSpecifierUSHLL(inst, tsize, d_esize, tsize, s_esize);
+  auto d_rclass = ArrangementRegClass(tsize, d_esize);
+  auto s_rclass = ArrangementRegClass(tsize, s_esize);
+  AddRegOperand(inst, accumulate ? kActionReadWrite : kActionWrite, d_rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, s_rclass, kUseAsValue, data.Rn);
+  return true;
+}
+
+bool TryDecodeUADDLP_ASIMDMISC_P(const InstData &data, Instruction &inst) {
+  return TryDecodeADDLP_ASIMDMISC(data, inst, false);
+}
+
+bool TryDecodeSADDLP_ASIMDMISC_P(const InstData &data, Instruction &inst) {
+  return TryDecodeADDLP_ASIMDMISC(data, inst, false);
+}
+
+bool TryDecodeUADALP_ASIMDMISC_P(const InstData &data, Instruction &inst) {
+  return TryDecodeADDLP_ASIMDMISC(data, inst, true);
+}
+
+bool TryDecodeSADALP_ASIMDMISC_P(const InstData &data, Instruction &inst) {
+  return TryDecodeADDLP_ASIMDMISC(data, inst, true);
+}
