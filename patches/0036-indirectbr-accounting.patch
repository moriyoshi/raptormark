 void TraceLifter::Impl::GenIndirectJumpCode(uint64_t trace_addr) {
+  // Timed at the DEFINITION, not at a call site: the earlier call-site timer read
+  // exactly 0.000s because the live caller is in ForkEmulation.cpp, not here.
+  struct EcvIndScope {
+    std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+    ~EcvIndScope() {
+      ecv_indirect_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(
+                             std::chrono::steady_clock::now() - t0)
+                             .count();
+      ecv_indirect_count++;
+    }
+  } ecv_ind_scope;
 
   auto u64ty = llvm::Type::getInt64Ty(context);
   auto u64ptrty = llvm::Type::getInt64PtrTy(context);
