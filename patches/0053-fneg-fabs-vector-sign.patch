+// FNEG/FABS  <Vd>.<T>, <Vn>.<T> -- the VECTOR (ASIMD two-register misc) sign
+// operations. Both were `return false` stubs, so a guest that negated a float
+// vector met `__ecv_warning` and took SIGILL.
+//
+// python:3-slim stops on `fneg v29.2d, v29.2d` inside `_PyCode_ConstantKey`,
+// which is CPython's `copysign` on a double: build a sign mask with FNEG of
+// zero, then blend with BIF. BIF was already implemented, so this pair is what
+// the whole sequence was missing. FABS goes in with it because it is the same
+// encoding with U=0 -- one lift, not two.
+//
+// Operands are FRINTM_ASIMDMISC_R's: one arrangement, the same register class
+// for source and destination. NO FPSR status operand: these do not read or
+// write the floating-point exception flags, because they are not arithmetic --
+// see the semantics.
+//
+// `sz && !Q` is the 1D arrangement, which is unallocated: 64-bit elements
+// require Q=1.
+static bool TryDecodeFSIGN_ASIMDMISC(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  if (data.sz && !data.Q) {
+    return false;
+  }
+  const uint64_t datasize = data.Q ? 128 : 64;
+  const uint64_t esize = data.sz ? 64 : 32;
+  AddArrangementSpecifier(inst, datasize, esize);
+  auto r_class = ArrangementRegClass(datasize, esize);
+  AddRegOperand(inst, kActionWrite, r_class, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, r_class, kUseAsValue, data.Rn);
+  return true;
+}
+
+bool TryDecodeFNEG_ASIMDMISC_R(const InstData &data, Instruction &inst) {
+  return TryDecodeFSIGN_ASIMDMISC(data, inst);
+}
+
+bool TryDecodeFABS_ASIMDMISC_R(const InstData &data, Instruction &inst) {
+  return TryDecodeFSIGN_ASIMDMISC(data, inst);
+}
