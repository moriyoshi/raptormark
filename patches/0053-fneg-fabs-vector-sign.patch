 namespace {
 
+// FNEG/FABS (vector): flip or clear each lane's SIGN BIT.
+//
+// These are bit operations, not arithmetic, and the distinction is the whole
+// point. ARM defines FPNeg as "invert bit[N-1]" and FPAbs as "clear bit[N-1]"
+// on the ENCODING, so:
+//
+//   * FNEG(+0.0) is -0.0. Implemented as `0.0 - x` it would be +0.0, and the
+//     one caller that matters here is `copysign`, whose entire job is the sign
+//     of a zero.
+//   * a NaN keeps its payload and its signalling-ness. `0.0 - NaN` may quiet a
+//     signalling NaN and is free to pick a different payload.
+//   * no FPSR exception flag is ever raised, which is why the decoder attaches
+//     no FPSR status operand.
+//
+// Reading the lanes as unsigned integers is therefore not a shortcut around the
+// float semantics; it IS the float semantics.
+
+// The sign bit of an IEEE-754 binary32 / binary64 lane.
+constexpr uint32_t kFPSign32 = uint32_t(1) << 31;
+constexpr uint64_t kFPSign64 = uint64_t(1) << 63;
+
+template <typename S>
+DEF_SEM_T(FNEG_Vec_32, S src) {
+  auto res = UReadVI32(src);
+  for (size_t i = 0; i < GetVectorElemsNum(res); i++) {
+    res[i] = res[i] ^ kFPSign32;
+  }
+  return res;
+}
+
+template <typename S>
+DEF_SEM_T(FNEG_Vec_64, S src) {
+  auto res = UReadVI64(src);
+  for (size_t i = 0; i < GetVectorElemsNum(res); i++) {
+    res[i] = res[i] ^ kFPSign64;
+  }
+  return res;
+}
+
+template <typename S>
+DEF_SEM_T(FABS_Vec_32, S src) {
+  auto res = UReadVI32(src);
+  for (size_t i = 0; i < GetVectorElemsNum(res); i++) {
+    res[i] = res[i] & ~kFPSign32;
+  }
+  return res;
+}
+
+template <typename S>
+DEF_SEM_T(FABS_Vec_64, S src) {
+  auto res = UReadVI64(src);
+  for (size_t i = 0; i < GetVectorElemsNum(res); i++) {
+    res[i] = res[i] & ~kFPSign64;
+  }
+  return res;
+}
+
+}  // namespace
+
+DEF_ISEL(FNEG_ASIMDMISC_R_2S) = FNEG_Vec_32<VIu32v2>;  // FNEG  <Vd>.<T>, <Vn>.<T>
+DEF_ISEL(FNEG_ASIMDMISC_R_4S) = FNEG_Vec_32<VIu32v4>;  // FNEG  <Vd>.<T>, <Vn>.<T>
+DEF_ISEL(FNEG_ASIMDMISC_R_2D) = FNEG_Vec_64<VIu64v2>;  // FNEG  <Vd>.<T>, <Vn>.<T>
+
+DEF_ISEL(FABS_ASIMDMISC_R_2S) = FABS_Vec_32<VIu32v2>;  // FABS  <Vd>.<T>, <Vn>.<T>
+DEF_ISEL(FABS_ASIMDMISC_R_4S) = FABS_Vec_32<VIu32v4>;  // FABS  <Vd>.<T>, <Vn>.<T>
+DEF_ISEL(FABS_ASIMDMISC_R_2D) = FABS_Vec_64<VIu64v2>;  // FABS  <Vd>.<T>, <Vn>.<T>
