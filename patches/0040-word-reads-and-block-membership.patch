+bool AArch64TraceManager::TryReadExecutableWord32(uint64_t addr, uint32_t *word) {
+  // Fast path: all four bytes inside one section, so one range check serves the
+  // whole word. A word straddling two sections falls back to the base's
+  // byte-at-a-time read, which is what the callers did before.
+  if (last_code_range < code_ranges.size()) {
+    const auto &r = code_ranges[last_code_range];
+    if (addr >= r.vma && addr + 4 <= r.vma + r.size) {
+      const uint8_t *p = r.bytes + (addr - r.vma);
+      *word = static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) |
+              (static_cast<uint32_t>(p[2]) << 16) | (static_cast<uint32_t>(p[3]) << 24);
+      return true;
+    }
+  }
+  auto it = std::upper_bound(code_ranges.begin(), code_ranges.end(), addr,
+                             [](uint64_t a, const CodeRange &r) { return a < r.vma; });
+  if (it != code_ranges.begin()) {
+    --it;
+    if (addr >= it->vma && addr + 4 <= it->vma + it->size) {
+      last_code_range = static_cast<size_t>(it - code_ranges.begin());
+      const uint8_t *p = it->bytes + (addr - it->vma);
+      *word = static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) |
+              (static_cast<uint32_t>(p[2]) << 16) | (static_cast<uint32_t>(p[3]) << 24);
+      return true;
+    }
+  }
+  return TraceManager::TryReadExecutableWord32(addr, word);
+}
