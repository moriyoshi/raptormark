   // at address `addr` is executable and readable, and updates the byte
   // pointed to by `byte` with the read value.
   virtual bool TryReadExecutableByte(uint64_t addr, uint8_t *byte) = 0;
+
+  // Reads the 4-byte instruction word at `addr`.
+  //
+  // The scan loops below read four separate bytes per 4-byte slot, and on a
+  // non-BTI binary they run to the 512 KiB `kFuncCap` for every function with an
+  // indirect branch (measured: busybox has 0 `bti c` markers in 268,891
+  // instructions, bash 26 in 524,416). That made byte reads 70% of the lift
+  // before patches/0038 and 17.6% after. One lookup per word instead of four is
+  // a pure read optimisation -- same bytes, same decisions.
+  //
+  // The default is exactly the four byte reads it replaces, so a manager that
+  // cannot do better, or a word straddling two sections, behaves identically.
+  virtual bool TryReadExecutableWord32(uint64_t addr, uint32_t *word) {
+    uint8_t b0 = 0, b1 = 0, b2 = 0, b3 = 0;
+    if (!TryReadExecutableByte(addr, &b0) || !TryReadExecutableByte(addr + 1, &b1) ||
+        !TryReadExecutableByte(addr + 2, &b2) || !TryReadExecutableByte(addr + 3, &b3)) {
+      return false;
+    }
+    *word = static_cast<uint32_t>(b0) | (static_cast<uint32_t>(b1) << 8) |
+            (static_cast<uint32_t>(b2) << 16) | (static_cast<uint32_t>(b3) << 24);
+    return true;
+  }
