+
+DEF_ISEL(ST1_ASISDLSEP_I3_I3_8B) = ST1_TRIPLE_POSTINDEX_64<MVI64>;
+DEF_ISEL(ST1_ASISDLSEP_I3_I3_16B) = ST1_TRIPLE_POSTINDEX_128<MVI128>;
+DEF_ISEL(ST1_ASISDLSEP_I3_I3_4H) = ST1_TRIPLE_POSTINDEX_64<MVI64>;
