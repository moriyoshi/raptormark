--- a/backend/remill/lib/Arch/AArch64/Semantics/DATAXFER.cpp
+++ b/backend/remill/lib/Arch/AArch64/Semantics/DATAXFER.cpp
@@ -1367,6 +1367,111 @@
 DEF_ISEL(ST1_ASISDLSEP_I2_I2_2D) =
     ST1_PAIR_POSTINDEX_128<MVI128>;  // ST1  { <Vt>.<T>, <Vt2>.<T> }, [<Xn|SP>], <imm>
 
+// ST1 with 1 (post-index), 3 and 4 source registers.
+//
+// These had NO `DEF_ISEL` *and* no real `TryDecode*` -- Decode.cpp carried
+// `return false` stubs -- so unlike the LD1 gaps they failed LOUDLY, as
+// `undecoded instruction`. Measured encodings: `0x4c9f7314`
+// (`st1 {v.16b},[x],#16`), `0x4c00600a` (`st1 {v-v-v},[x]`) and `0x4c9f62aa`
+// (`st1 {v-v-v},[x],#48`).
+//
+// Stores need no multi-value return, so no `TTriple`/`TQuad` here: the sources
+// arrive as ordinary operands and the semantics is a void run.
+namespace {
+
+#define MAKE_ST1_MULTI(elem_size) \
+  template <typename D> \
+  DEF_SEM_VOID_RUN(ST1_TRIPLE_##elem_size, VIu##elem_size##v1 src1, VIu##elem_size##v1 src2, \
+                   VIu##elem_size##v1 src3, D dst) { \
+    UWriteMVI##elem_size(rt_m, arena_ptr, dst, UReadVI##elem_size(src1)); \
+    UWriteMVI##elem_size(rt_m, arena_ptr, GetElementPtr(dst, 1U), UReadVI##elem_size(src2)); \
+    UWriteMVI##elem_size(rt_m, arena_ptr, GetElementPtr(dst, 2U), UReadVI##elem_size(src3)); \
+  } \
+  template <typename D> \
+  DEF_SEM_VOID_RUN(ST1_QUAD_##elem_size, VIu##elem_size##v1 src1, VIu##elem_size##v1 src2, \
+                   VIu##elem_size##v1 src3, VIu##elem_size##v1 src4, D dst) { \
+    UWriteMVI##elem_size(rt_m, arena_ptr, dst, UReadVI##elem_size(src1)); \
+    UWriteMVI##elem_size(rt_m, arena_ptr, GetElementPtr(dst, 1U), UReadVI##elem_size(src2)); \
+    UWriteMVI##elem_size(rt_m, arena_ptr, GetElementPtr(dst, 2U), UReadVI##elem_size(src3)); \
+    UWriteMVI##elem_size(rt_m, arena_ptr, GetElementPtr(dst, 3U), UReadVI##elem_size(src4)); \
+  }
+
+MAKE_ST1_MULTI(64)
+MAKE_ST1_MULTI(128)
+
+#undef MAKE_ST1_MULTI
+
+// Post-index delegates, as the pair forms do: `AddPostIndexMemOp` carries the
+// base-register update and the lifter applies it after the call.
+#define MAKE_ST1_MULTI_POSTINDEX(elem_size) \
+  template <typename D> \
+  DEF_SEM_VOID_RUN(ST1_SINGLE_POSTINDEX_##elem_size, VIu##elem_size##v1 src1, D dst) { \
+    ST1_SINGLE_##elem_size(arena_ptr, rt_m, src1, dst); \
+  } \
+  template <typename D> \
+  DEF_SEM_VOID_RUN(ST1_TRIPLE_POSTINDEX_##elem_size, VIu##elem_size##v1 src1, \
+                   VIu##elem_size##v1 src2, VIu##elem_size##v1 src3, D dst) { \
+    ST1_TRIPLE_##elem_size(arena_ptr, rt_m, src1, src2, src3, dst); \
+  } \
+  template <typename D> \
+  DEF_SEM_VOID_RUN(ST1_QUAD_POSTINDEX_##elem_size, VIu##elem_size##v1 src1, \
+                   VIu##elem_size##v1 src2, VIu##elem_size##v1 src3, VIu##elem_size##v1 src4, \
+                   D dst) { \
+    ST1_QUAD_##elem_size(arena_ptr, rt_m, src1, src2, src3, src4, dst); \
+  }
+
+MAKE_ST1_MULTI_POSTINDEX(64)
+MAKE_ST1_MULTI_POSTINDEX(128)
+
+#undef MAKE_ST1_MULTI_POSTINDEX
+
+}  // namespace
+
