diff --git a/backend/remill/lib/Arch/AArch64/Semantics/BINARY.cpp b/backend/remill/lib/Arch/AArch64/Semantics/BINARY.cpp
index 8611251..91b9602 100644
--- a/backend/remill/lib/Arch/AArch64/Semantics/BINARY.cpp
+++ b/backend/remill/lib/Arch/AArch64/Semantics/BINARY.cpp
@@ -838,3 +838,44 @@ MAKE_FNMSUB(64);
 
 DEF_ISEL(FNMSUB_S_FLOATDP3) = FNMSUB_32;
 DEF_ISEL(FNMSUB_D_FLOATDP3) = FNMSUB_64;
+
+// FNMUL   <Sd>, <Sn>, <Sm>          Sd = -(Sn * Sm)
+// FNMADD  <Sd>, <Sn>, <Sm>, <Sa>    Sd = -Sa - Sn*Sm  ==  -(Sa + Sn*Sm)
+//
+// raptormark: the negation is the whole instruction, and it is NOT the same as
+// negating an operand. `-(a*b)` and `(-a)*b` agree on every finite value and
+// disagree on a NaN payload's sign bit and on which zero you get -- and the
+// guest chose the form that negates the RESULT. Written that way here for the
+// same reason `FNEG` is a sign operation rather than `0 - x`: `0 - (-0.0)` is
+// `+0.0`, so a subtract-from-zero spelling silently loses signed zero.
+namespace {
+
+#define MAKE_FNMUL(esize) \
+  DEF_SEM_F##esize##_STATE(FNMUL_##esize, RF##esize src1, RF##esize src2) { \
+    auto prod = FMul##esize(Read(src1), Read(src2)); \
+    return -prod; \
+  }
+
+MAKE_FNMUL(32);
+MAKE_FNMUL(64);
+
+#undef MAKE_FNMUL
+
+#define MAKE_FNMADD(esize) \
+  DEF_SEM_F##esize##_STATE(FNMADD_##esize, RF##esize src1, RF##esize src2, RF##esize src3) { \
+    auto prod = FMul##esize(Read(src1), Read(src2)); \
+    auto sum = FAdd##esize(prod, Read(src3)); \
+    return -sum; \
+  }
+
+MAKE_FNMADD(32);
+MAKE_FNMADD(64);
+
+#undef MAKE_FNMADD
+
+}  // namespace
+
+DEF_ISEL(FNMUL_S_FLOATDP2) = FNMUL_32;  // FNMUL  <Sd>, <Sn>, <Sm>
+DEF_ISEL(FNMUL_D_FLOATDP2) = FNMUL_64;  // FNMUL  <Dd>, <Dn>, <Dm>
+DEF_ISEL(FNMADD_S_FLOATDP3) = FNMADD_32;  // FNMADD  <Sd>, <Sn>, <Sm>, <Sa>
+DEF_ISEL(FNMADD_D_FLOATDP3) = FNMADD_64;  // FNMADD  <Dd>, <Dn>, <Dm>, <Da>
