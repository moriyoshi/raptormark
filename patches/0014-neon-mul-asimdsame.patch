+// MUL  <Vd>.<T>, <Vn>.<T>, <Vm>.<T> (integer vector multiply). Same Rd/Rn/Rm/arrangement
+// operands as ADD, but size==0b11 (64-bit element) is RESERVED -- there is no 2D/1D MUL.
+bool TryDecodeMUL_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  if (0x3 == data.size) {
+    return false;  // `if size == '11' then ReservedValue();`
+  }
+  uint64_t total_size = data.Q ? 128 : 64;
+  uint64_t elem_size = 8UL << data.size;
+  AddArrangementSpecifier(inst, total_size, elem_size);
+  auto rclass = ArrangementRegClass(total_size, elem_size);
+  return TryDecodeRdW_Rn_Rm(data, inst, rclass);
+}
