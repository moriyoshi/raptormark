@@ -228,6 +228,39 @@
 DEF_ISEL(SMULH_64_DP_3SRC) = SMULH;
 
 DEF_ISEL(UDIV_32_DP_2SRC) = UDIV<R32>;  // UDIV  <Wd>, <Wn>, <Wm>
+
+// CRC32 / CRC32C (ARMv8 CRC32 extension).
+//
+// Both are the ordinary REFLECTED (LSB-first) CRC update, which is why the
+// constants below are bit-reversed polynomials: 0xEDB88320 reverses CRC-32's
+// 0x04C11DB7, and 0x82F63B78 reverses Castagnoli's 0x1EDC6F41. ARM's pseudocode
+// says the same thing with BitReverse/Poly32Mod2 around a big-endian division;
+// the reflected loop is the standard equivalent, and is exactly what the
+// software implementations these instructions replace already compute.
+//
+// The value operand is consumed low byte first, kBytes of it: 1/2/4 for the
+// B/H/W forms out of a W register, 8 for the X form out of an X register.
+template <typename ST, uint32_t kPoly, unsigned kBytes>
+DEF_SEM_T(CRC32, R32 acc, ST val) {
+  uint32_t crc = Read(acc);
+  uint64_t data = static_cast<uint64_t>(Read(val));
+  for (unsigned i = 0; i < kBytes; ++i) {
+    crc ^= static_cast<uint32_t>((data >> (8u * i)) & 0xffu);
+    for (unsigned b = 0; b < 8u; ++b) {
+      crc = (crc >> 1u) ^ (kPoly & (0u - (crc & 1u)));
+    }
+  }
+  return crc;
+}
+
+DEF_ISEL(CRC32B_32C_DP_2SRC) = CRC32<R32, 0xEDB88320u, 1>;  // CRC32B  <Wd>, <Wn>, <Wm>
+DEF_ISEL(CRC32H_32C_DP_2SRC) = CRC32<R32, 0xEDB88320u, 2>;  // CRC32H  <Wd>, <Wn>, <Wm>
+DEF_ISEL(CRC32W_32C_DP_2SRC) = CRC32<R32, 0xEDB88320u, 4>;  // CRC32W  <Wd>, <Wn>, <Wm>
+DEF_ISEL(CRC32X_64C_DP_2SRC) = CRC32<R64, 0xEDB88320u, 8>;  // CRC32X  <Wd>, <Wn>, <Xm>
+DEF_ISEL(CRC32CB_32C_DP_2SRC) = CRC32<R32, 0x82F63B78u, 1>;  // CRC32CB  <Wd>, <Wn>, <Wm>
+DEF_ISEL(CRC32CH_32C_DP_2SRC) = CRC32<R32, 0x82F63B78u, 2>;  // CRC32CH  <Wd>, <Wn>, <Wm>
+DEF_ISEL(CRC32CW_32C_DP_2SRC) = CRC32<R32, 0x82F63B78u, 4>;  // CRC32CW  <Wd>, <Wn>, <Wm>
+DEF_ISEL(CRC32CX_64C_DP_2SRC) = CRC32<R64, 0x82F63B78u, 8>;  // CRC32CX  <Wd>, <Wn>, <Xm>
