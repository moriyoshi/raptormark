+// MLA / MLS  <Vd>.<T>, <Vn>.<T>, <Vm>.<T> -- multiply-accumulate and
+// multiply-subtract, SAME width throughout (unlike the ASIMDDIFF *L family).
+//
+// Operands are MUL's, except that the destination is an accumulator and so is
+// read-write. That one difference is the whole of it, and it is the one a
+// copy of MUL gets wrong silently.
+static bool TryDecodeMLXA_ASIMDSAME(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  if (0x3 == data.size) {
+    return false;  // `if size == '11' then ReservedValue();`
+  }
+  const uint64_t total_size = data.Q ? 128 : 64;
+  const uint64_t elem_size = 8UL << data.size;
+  AddArrangementSpecifier(inst, total_size, elem_size);
+  auto rclass = ArrangementRegClass(total_size, elem_size);
+  AddRegOperand(inst, kActionReadWrite, rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rm);
+  return true;
+}
+
+bool TryDecodeMLA_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) {
+  return TryDecodeMLXA_ASIMDSAME(data, inst);
+}
+
+bool TryDecodeMLS_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) {
+  return TryDecodeMLXA_ASIMDSAME(data, inst);
+}
+
+// NEG / ABS  <Vd>.<T>, <Vn>.<T> -- the VECTOR integer sign operations.
+//
+// cryptography's Rust extension stops on `neg v28.2s, v31.2s` inside a
+// constant-time `cmov`. Unlike the float FNEG of patch 0053 these are real
+// arithmetic on integer lanes, so 64-bit elements ARE allowed -- but only with
+// Q=1, since the 1D arrangement is unallocated.
+static bool TryDecodeNEGABS_ASIMDMISC(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  if (data.size == 0x3 && !data.Q) {
+    return false;  // 1D is unallocated; 64-bit elements need Q=1.
+  }
+  const uint64_t total_size = data.Q ? 128 : 64;
+  const uint64_t elem_size = 8UL << data.size;
+  AddArrangementSpecifier(inst, total_size, elem_size);
+  auto rclass = ArrangementRegClass(total_size, elem_size);
+  AddRegOperand(inst, kActionWrite, rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rn);
+  return true;
+}
+
+bool TryDecodeNEG_ASIMDMISC_R(const InstData &data, Instruction &inst) {
+  return TryDecodeNEGABS_ASIMDMISC(data, inst);
+}
+
+bool TryDecodeABS_ASIMDMISC_R(const InstData &data, Instruction &inst) {
+  return TryDecodeNEGABS_ASIMDMISC(data, inst);
+}
+
+// USUBL{2}  <Vd>.<Ta>, <Vn>.<Tb>, <Vm>.<Tb> -- widening unsigned subtract.
+// Operand shape is SADDL's exactly; only the operation and signedness differ.
+bool TryDecodeUSUBL_ASIMDDIFF_L(const InstData &data, Instruction &inst) {
+  return TryDecodeSADDL_ASIMDDIFF_L(data, inst);
+}
