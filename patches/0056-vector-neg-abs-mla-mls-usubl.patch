+// NEG / ABS (vector integer), and MLA / MLS (same-width multiply-accumulate).
+//
+// Read as SIGNED lanes: ABS is only meaningful signed, and NEG of the most
+// negative value must wrap to itself rather than saturate (that is SQNEG, a
+// different instruction and still a stub). MLA/MLS wrap on overflow too.
+// Token pasting does not happen inside a macro ARGUMENT, so the operation
+// cannot be passed in -- NEG and ABS get one macro each.
+#define ECV_MAKE_NEG(esize) \
+  template <typename S> \
+  DEF_SEM_T(NEG_Vec_##esize, S src) { \
+    auto res = SReadVI##esize(src); \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(res); i++) { \
+      res[i] = static_cast<int##esize##_t>(static_cast<int##esize##_t>(0) - res[i]); \
+    } \
+    return res; \
+  }
+
+#define ECV_MAKE_ABS(esize) \
+  template <typename S> \
+  DEF_SEM_T(ABS_Vec_##esize, S src) { \
+    auto res = SReadVI##esize(src); \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(res); i++) { \
+      if (res[i] < 0) { \
+        res[i] = static_cast<int##esize##_t>(static_cast<int##esize##_t>(0) - res[i]); \
+      } \
+    } \
+    return res; \
+  }
+
+ECV_MAKE_NEG(8)
+ECV_MAKE_NEG(16)
+ECV_MAKE_NEG(32)
+ECV_MAKE_NEG(64)
+ECV_MAKE_ABS(8)
+ECV_MAKE_ABS(16)
+ECV_MAKE_ABS(32)
+ECV_MAKE_ABS(64)
+
+#undef ECV_MAKE_NEG
+#undef ECV_MAKE_ABS
+
+#define ECV_MAKE_MLXA(name, op, esize) \
+  template <typename S> \
+  DEF_SEM_T(name##_##esize, S dst, S srcn, S srcm) { \
+    auto srcn_v = UReadVI##esize(srcn); \
+    auto srcm_v = UReadVI##esize(srcm); \
+    auto res = UReadVI##esize(dst); \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(res); i++) { \
+      res[i] op uint##esize##_t(srcn_v[i] * srcm_v[i]); \
+    } \
+    return res; \
+  }
+
+ECV_MAKE_MLXA(MLA_Vec, +=, 8)
+ECV_MAKE_MLXA(MLA_Vec, +=, 16)
+ECV_MAKE_MLXA(MLA_Vec, +=, 32)
+ECV_MAKE_MLXA(MLS_Vec, -=, 8)
+ECV_MAKE_MLXA(MLS_Vec, -=, 16)
+ECV_MAKE_MLXA(MLS_Vec, -=, 32)
+
+#undef ECV_MAKE_MLXA
+
+// USUBL{2}: widening unsigned subtract. Widened BEFORE the subtract, so a
+// smaller-minus-larger pair gives a large positive wide value rather than a
+// truncated one -- the same ordering the widening multiplies of 0051 needed.
+#define ECV_MAKE_USUBL(s_esize, d_esize) \
+  template <typename D, typename S> \
+  DEF_SEM_T(USUBL_##s_esize, S srcn, S srcm) { \
+    auto srcn_v = UReadVI##s_esize(srcn); \
+    auto srcm_v = UReadVI##s_esize(srcm); \
+    D res{}; \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(res); i++) { \
+      res[i] = uint##d_esize##_t(srcn_v[i]) - uint##d_esize##_t(srcm_v[i]); \
+    } \
+    return res; \
+  } \
+  template <typename D, typename S> \
+  DEF_SEM_T(USUBL2_##s_esize, S srcn, S srcm) { \
+    auto srcn_v = UReadVI##s_esize(srcn); \
+    auto srcm_v = UReadVI##s_esize(srcm); \
+    D res{}; \
+    auto n = GetVectorElemsNum(res); \
+    _Pragma("unroll") for (size_t i = 0; i < n; i++) { \
+      res[i] = uint##d_esize##_t(srcn_v[i + n]) - uint##d_esize##_t(srcm_v[i + n]); \
+    } \
+    return res; \
+  }
+
+ECV_MAKE_USUBL(8, 16)
+ECV_MAKE_USUBL(16, 32)
+ECV_MAKE_USUBL(32, 64)
+
+#undef ECV_MAKE_USUBL
+
