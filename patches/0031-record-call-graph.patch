 namespace remill {
 
+// Call-graph edge recording, for the Go-orchestrated pipeline.
+//
+// ECV_GRAPH_OUT names a file to write "<caller> <callee>" hex pairs to, one per
+// line. Sharding the lift by function ENTRY does not divide the work -- measured
+// on a fused bash, two 32-way shards each lifted ~2,100 functions of which 1,728
+// were the SAME functions, because Lift() walks a trace work-list and every
+// closure reaches libc. Partitioning has to be computed over the call graph
+// instead, and this is where the edges already exist: every
+// trace_work_list.insert below is a function-level edge.
+//
+// Recording is passive and costs nothing when the variable is unset.
+static void EcvRecordCallGraphEdge(uint64_t from, uint64_t to) {
+  static FILE *const out = [] {
+    const char *path = getenv("ECV_GRAPH_OUT");
+    return path ? fopen(path, "w") : nullptr;
+  }();
+  if (out) {
+    fprintf(out, "%llx %llx\n", (unsigned long long) from, (unsigned long long) to);
+  }
+}
