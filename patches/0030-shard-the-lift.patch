+  // Shard selection. Parsed once; shard_n == 1 lifts everything, which is the
+  // behaviour when --shard is absent.
+  uint64_t shard_i = 0, shard_n = 1;
+  if (!FLAGS_shard.empty()) {
+    auto slash = FLAGS_shard.find('/');
+    if (slash == std::string::npos) {
+      elfconv_runtime_error("[ERROR] --shard wants \"i/N\", got \"%s\".\n", FLAGS_shard.c_str());
+    }
+    shard_i = std::stoull(FLAGS_shard.substr(0, slash));
+    shard_n = std::stoull(FLAGS_shard.substr(slash + 1));
+    if (shard_n == 0 || shard_i >= shard_n) {
+      elfconv_runtime_error("[ERROR] --shard \"%s\" is out of range.\n", FLAGS_shard.c_str());
+    }
+  }
+
+  // Assignment is a pure function of the function's ADDRESS, never of iteration
+  // or discovery order, so a given function lands in the same shard in every run
+  // and in every process -- which is what lets shards be cached independently.
+  //
+  // It must be a MIXING hash, not the low address bits. Function entry points are
+  // heavily aligned: measured on these fixtures, 84.6% of bash-glibc's 6,578
+  // functions and 87.8% of aptget-glibc's 18,946 start on a 16-byte boundary. An
+  // `(addr >> 2) % N` rule is then just address bits [3:2] and degenerates -- it
+  // put 26.5 MB of a 27.6 MB module into one of four shards. This is the
+  // splitmix64 finalizer, which decorrelates those bits.
+  auto shard_of = [](uint64_t addr) {
+    uint64_t x = addr;
+    x ^= x >> 33;
+    x *= 0xff51afd7ed558ccdULL;
+    x ^= x >> 33;
+    x *= 0xc4ceb9fe1a85ec53ULL;
+    x ^= x >> 33;
+    return x;
+  };
+  auto in_shard = [&](uint64_t addr) {
+    return shard_n == 1 || shard_of(addr) % shard_n == shard_i;
+  };
