+// STLRB  <Wt>, [<Xn|SP>{,#0}]  (store-release byte; mirrors STLR_SL32, byte width
+// comes from the semantics operand type M8W in DATAXFER.cpp).
+bool TryDecodeSTLRB_SL32_LDSTEXCL(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Runtime;
+  AddRegOperand(inst, kActionRead, kRegW, kUseAsValue, data.Rt);
+  AddBasePlusOffsetMemOp(inst, 32, data.Rn, 0);
+  return true;
+}
+
+// STLRH  <Wt>, [<Xn|SP>{,#0}]  (store-release halfword; width from M16W).
+bool TryDecodeSTLRH_SL32_LDSTEXCL(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Runtime;
+  AddRegOperand(inst, kActionRead, kRegW, kUseAsValue, data.Rt);
+  AddBasePlusOffsetMemOp(inst, 32, data.Rn, 0);
+  return true;
+}
