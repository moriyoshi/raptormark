 DEF_ISEL(FRINTM_ASIMDMISC_R_2D_FPSRSTATUS) = FRINTM_Vector64<VIf64v2>;
 
+// FRINT{N,A,P,Z,I,X}  <Vd>.<T>, <Vn>.<T> -- the six vector rounding modes
+// upstream left as decode stubs, written from FRINTM_Vector above.
+//
+// The helper per mode is the one patches 0004/0011 settled on for the scalar
+// forms, so scalar and vector cannot disagree: wasm rounds to nearest-even
+// natively, which makes `std::nearbyint` under the default FE_TONEAREST the
+// right implementation of N, and `std::round` the right one of A.
+namespace {
+
+#define MAKE_FRINT_VECTOR(name, round) \
+  template <typename S> \
+  DEF_SEM_T_STATE(name##_Vector32, S src) { \
+    auto srcv = FReadVI32(src); \
+    S res = {}; \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(srcv); i++) { \
+      res[i] = round(srcv[i]); \
+    } \
+    return res; \
+  } \
+  template <typename S> \
+  DEF_SEM_T_STATE(name##_Vector64, S src) { \
+    auto srcv = FReadVI64(src); \
+    S res = {}; \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(srcv); i++) { \
+      res[i] = round(srcv[i]); \
+    } \
+    return res; \
+  }
+
+// FRINTN: round to nearest, ties to EVEN -- what nearbyint does under the default FE_TONEAREST.
+MAKE_FRINT_VECTOR(FRINTN, std::nearbyint)
+// FRINTA: round to nearest, ties AWAY from zero.
+MAKE_FRINT_VECTOR(FRINTA, std::round)
+// FRINTP: round toward +infinity.
+MAKE_FRINT_VECTOR(FRINTP, std::ceil)
+// FRINTZ: round toward zero.
+MAKE_FRINT_VECTOR(FRINTZ, std::trunc)
+// FRINTI: round using the FPCR mode; ecvisor never changes it from RN, so this is FRINTN.
+MAKE_FRINT_VECTOR(FRINTI, std::nearbyint)
+// FRINTX: as FRINTI, but signals Inexact -- same VALUE, and the flag is not modelled.
+MAKE_FRINT_VECTOR(FRINTX, std::nearbyint)
+
+#undef MAKE_FRINT_VECTOR
+
+}  // namespace
