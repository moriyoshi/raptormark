@@ -59,12 +59,44 @@
 // steady_clock reads per instruction is ~20 ns against a lift measured in
 // minutes.
 static uint64_t ecv_decode_ns = 0, ecv_emit_ns = 0, ecv_insn_count = 0;
+// Where the other ~95% goes. decode+emit are 4.1-4.5% of a lift, so the cost is
+// the machinery around them; these account for the per-trace passes that walk
+// every block, and for the per-block bookkeeping the disabled VRO path consumes.
+static uint64_t ecv_indirect_ns = 0, ecv_fork_ns = 0;
+static uint64_t ecv_bbreg_ns = 0, ecv_bbreg_count = 0;
+static uint64_t ecv_vropt_ns = 0, ecv_vropt_count = 0;
+
+template <typename... A>
+static BBRegInfoNode *EcvNewBBRegInfoNode(A &&...args) {
+  auto t0 = std::chrono::steady_clock::now();
+  auto *p = ::new BBRegInfoNode(std::forward<A>(args)...);
+  ecv_bbreg_ns +=
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0)
+          .count();
+  ecv_bbreg_count++;
+  return p;
+}
+
+template <typename... A>
+static VirtualRegsOpt *EcvNewVirtualRegsOpt(A &&...args) {
+  auto t0 = std::chrono::steady_clock::now();
+  auto *p = ::new VirtualRegsOpt(std::forward<A>(args)...);
+  ecv_vropt_ns +=
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0)
+          .count();
+  ecv_vropt_count++;
+  return p;
+}
