+bool EcvReg::CheckStoreBeforeCall() const {
+  // Every register a callee could read from the caller's live state through the
+  // global State struct: all GP regs x0..x30, SP, and the callee-saved FP regs
+  // v8..v15. Broader than CheckPassedArgsRegs (args only) specifically so glibc's
+  // hand-written setjmp -- which snapshots the caller's callee-saved x19..x28,
+  // x29(fp), x30(lr), sp and v8..v15 into the jmp_buf -- captures correct values
+  // rather than stale globals. Extra stores for a normal callee are harmless
+  // (global just tracks local).
+  switch (reg_kind) {
+    case RegKind::General: return number <= 30 || SP_ORDER == number;
+    case RegKind::Vector: return 8 <= number && number <= 15;
+    default: return SP_ORDER == number;
+  }
+}
