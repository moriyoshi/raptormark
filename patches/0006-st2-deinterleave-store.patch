 DEF_ISEL(ST1_ASISDLSEP_I2_I2_2D) =
     ST1_PAIR_POSTINDEX_128<MVI128>;  // ST1  { <Vt>.<T>, <Vt2>.<T> }, [<Xn|SP>], <imm>
 
+// ST2 { <Vt>.<T>, <Vt2>.<T> }, [<Xn|SP>]{, <imm>}  -- store two registers with
+// element de-interleaving: mem[2*i] = src1.elem[i], mem[2*i+1] = src2.elem[i].
+// Built as two register-width output vectors (out0 = interleaved stream[0..n),
+// out1 = stream[n..2n)) written to consecutive register slots -- the ST1_PAIR
+// write idiom. The post-index variant reuses the body; its base-register
+// writeback is decoder-driven (AddPostIndexMemOp), as for ST1.
+namespace {
+#define MAKE_ST2(es) \
+  template <typename V, typename D> \
+  DEF_SEM_VOID_RUN(ST2_##es, V src1, V src2, D dst) { \
+    auto s1 = UReadVI##es(src1); \
+    auto s2 = UReadVI##es(src2); \
+    auto n = GetVectorElemsNum(s1); \
+    auto out0 = s1; \
+    auto out1 = s2; \
+    _Pragma("unroll") for (size_t j = 0; j < n; j++) { \
+      out0[j] = (j & 1) ? s2[j / 2] : s1[j / 2]; \
+      size_t k = j + n; \
+      out1[j] = (k & 1) ? s2[k / 2] : s1[k / 2]; \
+    } \
+    UWriteMVI##es(rt_m, arena_ptr, dst, out0); \
+    UWriteMVI##es(rt_m, arena_ptr, GetElementPtr(dst, 1U), out1); \
+  } \
+  template <typename V, typename D> \
+  DEF_SEM_VOID_RUN(ST2_POSTINDEX_##es, V src1, V src2, D dst) { \
+    ST2_##es<V, D>(arena_ptr, rt_m, src1, src2, dst); \
+  }
+
+MAKE_ST2(8)
+MAKE_ST2(16)
+MAKE_ST2(32)
+MAKE_ST2(64)
+
+#undef MAKE_ST2
+
+}  // namespace
+
+DEF_ISEL(ST2_ASISDLSE_R2_8B) = ST2_8<VIu8v8, MVI64>;
