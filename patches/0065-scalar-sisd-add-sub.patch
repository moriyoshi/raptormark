+// raptormark: scalar (SISD) integer ADD and SUB, which were generated stubs
+// returning `false`.
+//
+// Found by REACHING them, not by counting: `ExecInitAgg+0x10e0` is
+// `5eff8421 add d1, d1, d31`, and it stopped `postgres --single` on a
+// `GROUP BY` -- a hash aggregate, which a plain `count(*)` does not plan. The
+// matching `sub d12, d12, d31` sits in `hash_agg_set_limits`. Two sites, one
+// query rung.
+//
+// ⚠️ Modelled as `kReg2D` with lane 1 zeroed, exactly like the USHL scalar form
+// above. These are SIMD-register operations, not GPR ones: `ADD Dd, Dn, Dm`
+// reads and writes the low 64 bits of a V register and ZEROES the upper 64.
+// Reading them as 64-bit GPR adds would give the right lane-0 answer and leave
+// the top half of the destination undisturbed, which is wrong and would show up
+// only where the register is later read as a full 128-bit vector.
+//
+// The ARM spec allows only size=3 (double) for these; the encoding's `size`
+// field is not otherwise consulted here because the dispatch table reaches this
+// decoder only for that form.
+
+// ADD  <V><d>, <V><n>, <V><m>
+bool TryDecodeADD_ASISDSAME_ONLY(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  AddRegOperand(inst, kActionWrite, kReg2D, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kReg2D, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kReg2D, kUseAsValue, data.Rm);
+  return true;
+}
+
+// SUB  <V><d>, <V><n>, <V><m>
+bool TryDecodeSUB_ASISDSAME_ONLY(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  AddRegOperand(inst, kActionWrite, kReg2D, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kReg2D, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kReg2D, kUseAsValue, data.Rm);
+  return true;
+}
+
