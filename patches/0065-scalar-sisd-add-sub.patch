diff --git a/backend/remill/lib/Arch/AArch64/Semantics/SIMD.cpp b/backend/remill/lib/Arch/AArch64/Semantics/SIMD.cpp
index 78f11b3..b1e8168 100644
--- a/backend/remill/lib/Arch/AArch64/Semantics/SIMD.cpp
+++ b/backend/remill/lib/Arch/AArch64/Semantics/SIMD.cpp
@@ -1227,6 +1227,36 @@ DEF_SEM_T(USHL_64B, VIu64v2 src, VIi64v2 shift_src) {
 
 DEF_ISEL(USHL_ASISDSAME_ONLY) = USHL_64B;  // USHL  <V><d>, <V><n>, <V><m>
 
+// ADD/SUB  <V><d>, <V><n>, <V><m>  -- scalar (SISD), 64-bit only.
+//
+// Lane 1 is written as ZERO rather than left alone: an AArch64 write to a D
+// register clears the upper 64 bits of the V register. Preserving them instead
+// would be invisible in the arithmetic and wrong in the register file.
+namespace {
+
+DEF_SEM_T(ADD_Scalar64, VIu64v2 srcn, VIu64v2 srcm) {
+  auto n0 = UExtractVI64(UReadVI64(srcn), 0);
+  auto m0 = UExtractVI64(UReadVI64(srcm), 0);
+  VIu64v2 res = {};
+  res[0] = UAdd64(n0, m0);
+  res[1] = 0;
+  return res;
+}
+
+DEF_SEM_T(SUB_Scalar64, VIu64v2 srcn, VIu64v2 srcm) {
+  auto n0 = UExtractVI64(UReadVI64(srcn), 0);
+  auto m0 = UExtractVI64(UReadVI64(srcm), 0);
+  VIu64v2 res = {};
+  res[0] = USub64(n0, m0);
+  res[1] = 0;
+  return res;
+}
+
+}  // namespace
+
+DEF_ISEL(ADD_ASISDSAME_ONLY) = ADD_Scalar64;  // ADD  <V><d>, <V><n>, <V><m>
+DEF_ISEL(SUB_ASISDSAME_ONLY) = SUB_Scalar64;  // SUB  <V><d>, <V><n>, <V><m>
+
