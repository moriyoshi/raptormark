+// LD2R / LD3R / LD4R  { <Vt>.<T>, ... }, [<Xn|SP>]
+//
+// Load N consecutive elements and REPLICATE each across its own destination
+// register -- a different family from the multiple-structures LD1/ST1 forms
+// (0072-0074), which distribute one contiguous block across the registers.
+//
+// These had `return false` stubs in Decode.cpp and no semantics, so they were
+// fatal `undecoded instruction`. Go reaches `LD4R` in
+// `internal/chacha8rand.block` during runtime start-up:
+//
+//   1ef44: 4d60e940  ld4r {v0.4s-v3.4s}, [x10]
+//
+// The multi-value return reuses the `TTriple`/`TQuad` types added in 0073; the
+// lifter writes an N-element struct return across N destination registers with
+// no special-casing.
+namespace {
+
+#define MAKE_LDNR(elem_size) \
+  template <typename V, typename MT> \
+  DEF_SEM_T_RUN(LD2R_##elem_size, MT mem) { \
+    auto m0 = ReadMem(rt_m, arena_ptr, mem); \
+    auto m1 = ReadMem(rt_m, arena_ptr, GetElementPtr(mem, 1U)); \
+    V r0 = {}, r1 = {}; \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(r0); i++) { \
+      r0[i] = m0; \
+      r1[i] = m1; \
+    } \
+    return TPair<V>{r0, r1}; \
+  } \
+  template <typename V, typename MT> \
+  DEF_SEM_T_RUN(LD3R_##elem_size, MT mem) { \
+    auto m0 = ReadMem(rt_m, arena_ptr, mem); \
+    auto m1 = ReadMem(rt_m, arena_ptr, GetElementPtr(mem, 1U)); \
+    auto m2 = ReadMem(rt_m, arena_ptr, GetElementPtr(mem, 2U)); \
+    V r0 = {}, r1 = {}, r2 = {}; \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(r0); i++) { \
+      r0[i] = m0; \
+      r1[i] = m1; \
+      r2[i] = m2; \
+    } \
+    return TTriple<V>{r0, r1, r2}; \
+  } \
+  template <typename V, typename MT> \
+  DEF_SEM_T_RUN(LD4R_##elem_size, MT mem) { \
+    auto m0 = ReadMem(rt_m, arena_ptr, mem); \
+    auto m1 = ReadMem(rt_m, arena_ptr, GetElementPtr(mem, 1U)); \
+    auto m2 = ReadMem(rt_m, arena_ptr, GetElementPtr(mem, 2U)); \
+    auto m3 = ReadMem(rt_m, arena_ptr, GetElementPtr(mem, 3U)); \
+    V r0 = {}, r1 = {}, r2 = {}, r3 = {}; \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(r0); i++) { \
+      r0[i] = m0; \
+      r1[i] = m1; \
+      r2[i] = m2; \
+      r3[i] = m3; \
+    } \
+    return TQuad<V>{r0, r1, r2, r3}; \
+  }
+
+MAKE_LDNR(8)
+MAKE_LDNR(16)
+MAKE_LDNR(32)
+MAKE_LDNR(64)
+
+#undef MAKE_LDNR
+
+}  // namespace
+
+DEF_ISEL(LD2R_ASISDLSO_R2_8B) = LD2R_8<VIu8v8, M8>;
