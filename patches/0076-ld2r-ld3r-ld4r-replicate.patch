+// LD2R/LD3R/LD4R { <Vt>.<T>, ... }, [<Xn|SP>]
+//
+// Same shape as LD1R above, with N consecutive destination registers. The
+// memory operand keeps the SINGLE-element size, as LD1R's does: the semantics
+// walks to the 2nd..Nth elements with `GetElementPtr`, so the operand type must
+// stay the one-element type (`M32` for `.4s`, etc.) or it would not match.
+//
+// Destination numbering wraps at 32, the same rule `TryDecodeLDn` applies to
+// the multiple-structures forms.
+static bool TryDecodeLDnR(const InstData &data, Instruction &inst, uint8_t num_regs) {
+  inst.sema_func_arg_type = SemaFuncArgType::Runtime;
+  auto elem_size = 8UL << data.size;
+  auto total_size = data.Q ? 128 : 64;
+  auto t = static_cast<uint8_t>(data.Rt);
+  for (uint8_t i = 0; i < num_regs; ++i) {
+    AddRegOperand(inst, kActionWrite, ArrangementRegClass(total_size, elem_size), kUseAsValue,
+                  static_cast<aarch64::RegNum>((t + i) % 32));
+  }
+  AddArrangementSpecifier(inst, total_size, elem_size);
+  AddBasePlusOffsetMemOp(inst, elem_size, data.Rn, 0);
+  return true;
+}
+
+// LD2R  { <Vt>.<T>, <Vt2>.<T> }, [<Xn|SP>]
+bool TryDecodeLD2R_ASISDLSO_R2(const InstData &data, Instruction &inst) {
+  return TryDecodeLDnR(data, inst, 2);
+}
+
+// LD3R  { <Vt>.<T>, <Vt2>.<T>, <Vt3>.<T> }, [<Xn|SP>]
+bool TryDecodeLD3R_ASISDLSO_R3(const InstData &data, Instruction &inst) {
+  return TryDecodeLDnR(data, inst, 3);
+}
+
+// LD4R  { <Vt>.<T>, <Vt2>.<T>, <Vt3>.<T>, <Vt4>.<T> }, [<Xn|SP>]
+bool TryDecodeLD4R_ASISDLSO_R4(const InstData &data, Instruction &inst) {
+  return TryDecodeLDnR(data, inst, 4);
+}
+
