+// The one `ret void` block every suspend check in this function branches to.
+llvm::BasicBlock *TraceLifter::Impl::GetOrCreateSuspendRetBlock() {
+  if (!suspend_ret_bb) {
+    suspend_ret_bb = llvm::BasicBlock::Create(context, "L_suspend_ret", func);
+    llvm::ReturnInst::Create(context, suspend_ret_bb);
+    virtual_regs_opt->bb_reg_info_node_map.insert(
+        {suspend_ret_bb, new BBRegInfoNode(func, state_ptr, runtime_ptr)});
+  }
+  return suspend_ret_bb;
+}
+
+// Emit the suspend check that gets a blocked process back to the scheduler.
+//
+// The cooperative scheduler suspends a process inside a blocking syscall (or on
+// exit/execve) and rebuilds its stack by call-history replay when it next runs,
+// so the frames between the syscall and the scheduler carry nothing worth
+// saving -- they only have to be torn down. A plain `ret` does that: it needs no
+// wasm proposal (unlike the exnref EH unwind this replaces, which no released
+// containerd shim enables), and it runs each function's real epilogue, so the
+// `__stack_pointer` global is popped instead of leaking one frame per yield.
+//
+// Placement is not free: the check must sit exactly where the EH unwind used to
+// leave the function -- after the call/syscall and BEFORE the caller's
+// `_ecv_func_epilogue`. The unwind returned from inside the callee, so the
+// caller's epilogue never ran and never popped the call history; the history is
+// the replay material, so popping it here would lose the frame.
+//
+// Nothing is spilled because fork_emulation forces norm_mode (Lift.cpp), which
+// disables VRP and makes AddStoreForAllSemantics unconditional: every guest
+// register already lives in the State struct at this point.
+llvm::BasicBlock *TraceLifter::Impl::AddSuspendCheck(llvm::BasicBlock *block) {
+  auto cont_bb = llvm::BasicBlock::Create(context, "L_no_suspend", func);
+  virtual_regs_opt->bb_reg_info_node_map.insert(
+      {cont_bb, new BBRegInfoNode(func, state_ptr, runtime_ptr)});
+
+  llvm::IRBuilder<> ir(block);
+  auto flag = ir.CreateCall(module->getFunction("_ecv_suspended"), {runtime_ptr});
+  auto cond = ir.CreateICmpNE(flag, llvm::ConstantInt::get(flag->getType(), 0));
+  ConditionalBranchWithSaveParents(GetOrCreateSuspendRetBlock(), cont_bb, cond, block);
+  return cont_bb;
+}
