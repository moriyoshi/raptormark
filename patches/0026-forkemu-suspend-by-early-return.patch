+// Always 0 for this runtime. The suspend-by-early-return path the fork_emulation
+// codegen emits belongs to the raptormark supervisor (ecvisor), which suspends a
+// process by raising this flag and letting every lifted frame return; here the
+// emscripten runtime still suspends by asyncify unwind, so the check must never
+// fire and the lifted code proceeds exactly as it did before. The definition
+// exists because the codegen emits the call unconditionally under
+// --fork_emulation, and an undefined symbol would break the upstream link.
+extern "C" uint8_t _ecv_suspended(RuntimeManager &rt_m) {
+  return 0;
+}
