+// FMOV  <Vd>.2D, #<imm>
+// AdvSIMD modified-immediate FMOV (vector, immediate), 64-bit lanes (op=1,
+// cmode=1111, Q=1). The generated decoder stubs this to `return false`, so an
+// unlifted block traps at runtime. clang emits `fmov v.2d, #-1.0` for vectorized
+// struct init (e.g. RestrictInfo cost fields), which the query planner hits.
+// The abcdefgh imm8 expands to an IEEE-754 double via VFPExpandImmToFloat64
+// (returns the raw 64-bit pattern); both D lanes get that value, which is exactly
+// the MOVI_D2 (I64 replicate) semantic reused here.
+bool TryDecodeFMOV_ASIMDIMM_D2_D(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  AddRegOperand(inst, kActionWrite, kReg2D, kUseAsValue, data.Rd);
+  AddImmOperand(inst, VFPExpandImmToFloat64(data.imm8.uimm));
+  return true;
+}
+
