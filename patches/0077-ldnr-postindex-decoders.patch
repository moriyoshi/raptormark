+// LD<n>R { ... }, [<Xn|SP>], <imm> -- POST-INDEX.
+//
+// Same operands as the plain forms; only the memory operand differs.
+// `AddPostIndexMemOp` carries the base-register update and the lifter applies
+// it after the call, so the SEMANTICS are shared with the non-post-index forms
+// -- the ISELs below point at the same functions.
+//
+// ❗ The access size stays ONE element, as in `TryDecodeLDnR`, while the
+// advance is `num_regs * elem_bytes`: `ld4r {v4.4s-v7.4s}, [x0], #16` reads
+// four 4-byte elements and advances 16.
+static bool TryDecodeLDnR_POSTINDEX(const InstData &data, Instruction &inst, uint8_t num_regs) {
+  inst.sema_func_arg_type = SemaFuncArgType::Runtime;
+  auto elem_size = 8UL << data.size;
+  auto total_size = data.Q ? 128 : 64;
+  auto t = static_cast<uint8_t>(data.Rt);
+  for (uint8_t i = 0; i < num_regs; ++i) {
+    AddRegOperand(inst, kActionWrite, ArrangementRegClass(total_size, elem_size), kUseAsValue,
+                  static_cast<aarch64::RegNum>((t + i) % 32));
+  }
+  AddArrangementSpecifier(inst, total_size, elem_size);
+  AddPostIndexMemOp(inst, elem_size, data.Rn, num_regs * (elem_size / 8));
+  return true;
+}
+
+// LD1R  { <Vt>.<T> }, [<Xn|SP>], <imm>
+bool TryDecodeLD1R_ASISDLSOP_R1_I(const InstData &data, Instruction &inst) {
+  return TryDecodeLDnR_POSTINDEX(data, inst, 1);
+}
+
+// LD2R  { <Vt>.<T>, <Vt2>.<T> }, [<Xn|SP>], <imm>
+bool TryDecodeLD2R_ASISDLSOP_R2_I(const InstData &data, Instruction &inst) {
+  return TryDecodeLDnR_POSTINDEX(data, inst, 2);
+}
+
+// LD3R  { <Vt>.<T>, <Vt2>.<T>, <Vt3>.<T> }, [<Xn|SP>], <imm>
+bool TryDecodeLD3R_ASISDLSOP_R3_I(const InstData &data, Instruction &inst) {
+  return TryDecodeLDnR_POSTINDEX(data, inst, 3);
+}
+
+// LD4R  { <Vt>.<T>, <Vt2>.<T>, <Vt3>.<T>, <Vt4>.<T> }, [<Xn|SP>], <imm>
+bool TryDecodeLD4R_ASISDLSOP_R4_I(const InstData &data, Instruction &inst) {
+  return TryDecodeLDnR_POSTINDEX(data, inst, 4);
+}
+
