+// {0xFFFFFFFF, 3} produced the bit patterns {0, 3} instead of {4.29e9, 3.0}.
+// SCVTF next door already carries the two type parameters; this is that.
 #define MAKE_UCVTF_VECTOR(elem_size) \
-  template <typename S> \
+  template <typename S, typename D> \
   DEF_SEM_T_STATE(UCVTF_Vector_##elem_size, S srcn) { \
