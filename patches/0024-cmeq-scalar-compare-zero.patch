+// CMEQ  <V><d>, <V><n>, #0 (scalar). The vector form above is implemented; only
+// the 1D scalar was left as a generated stub, and clang emits it for a plain
+// 64-bit "is this zero" -- musl and nginx both reach it on ordinary code paths.
+bool TryDecodeCMEQ_ASISDMISC_Z(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  if (data.size != 0b11) {
+    return false;  // size must be 0b11
+  }
+  AddRegOperand(inst, kActionWrite, kReg1D, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kReg1D, kUseAsValue, data.Rn);
+  return true;
+}
