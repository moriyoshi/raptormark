+// SWPAL  <Ws>, <Wt>, [<Xn|SP>]
+//
+// raptormark: SWP with BOTH acquire and release ordering. Its three siblings
+// (SWP, SWPA, SWPL) were decoded here and share one semantics template; only
+// the acquire-release form was left as a generated stub returning false. That
+// made it decode as INVALID, so any binary using
+// __atomic_exchange_n(..., __ATOMIC_ACQ_REL) -- the ordering GCC emits for a
+// plain C11 atomic exchange -- trapped at run time with `unreachable`.
+//
+// Ordering is not modelled: the guest is cooperatively scheduled and never
+// preempted mid-instruction, which is the same assumption the existing SWPA and
+// SWPL decoders make. The operand shape is therefore identical to SWPA.
+bool TryDecodeSWPAL_32_MEMOP(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Runtime;
+  AddRegOperand(inst, kActionWrite, kRegW, kUseAsValue, data.Rs);
+  AddRegOperand(inst, kActionRead, kRegW, kUseAsValue, data.Rt);
+  AddBasePlusOffsetMemOp(inst, 32, data.Rn, 0);
+  return true;
+}
+
+// SWPAL  <Xs>, <Xt>, [<Xn|SP>]
+bool TryDecodeSWPAL_64_MEMOP(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Runtime;
+  AddRegOperand(inst, kActionWrite, kRegX, kUseAsValue, data.Rs);
+  AddRegOperand(inst, kActionRead, kRegX, kUseAsValue, data.Rt);
+  AddBasePlusOffsetMemOp(inst, 64, data.Rn, 0);
+  return true;
+}
+
