+// Limited Ordering Region (LOR) load-acquire / store-release variants. Modeled as
+// full acquire/release -- a stronger barrier is always sound in elfconv's cooperative
+// single-threaded replay (ordering only matters at syscall boundaries). Stubbed
+// (return false) in Decode.cpp upstream; real decoders here mirror STLR/LDAR.
+
+// STLLRB  <Wt>, [<Xn|SP>{,#0}]
+bool TryDecodeSTLLRB_SL32_LDSTEXCL(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Runtime;
+  AddRegOperand(inst, kActionRead, kRegW, kUseAsValue, data.Rt);
+  AddBasePlusOffsetMemOp(inst, 8, data.Rn, 0);
+  return true;
+}
