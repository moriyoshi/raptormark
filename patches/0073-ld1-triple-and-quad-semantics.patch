+//
+// Before this, all four were silent NO-OPS -- decoded, but with no live
+// `DEF_ISEL`, so they neither loaded a single vector nor advanced anything.
+namespace {
+
+#define MAKE_LD1_TRIPLE(elem_size) \
+  template <typename S> \
+  DEF_SEM_T_RUN(LD1_TRIPLE_##elem_size, S src) { \
+    auto e1 = UReadMVI##elem_size(rt_m, arena_ptr, src); \
+    auto e2 = UReadMVI##elem_size(rt_m, arena_ptr, GetElementPtr(src, 1U)); \
+    auto e3 = UReadMVI##elem_size(rt_m, arena_ptr, GetElementPtr(src, 2U)); \
+    return TTriple<decltype(e1)>{e1, e2, e3}; \
+  }
+
+MAKE_LD1_TRIPLE(8)
+MAKE_LD1_TRIPLE(16)
+MAKE_LD1_TRIPLE(32)
+MAKE_LD1_TRIPLE(64)
+
+#undef MAKE_LD1_TRIPLE
+
+#define MAKE_LD1_QUAD(elem_size) \
+  template <typename S> \
+  DEF_SEM_T_RUN(LD1_QUAD_##elem_size, S src) { \
+    auto e1 = UReadMVI##elem_size(rt_m, arena_ptr, src); \
+    auto e2 = UReadMVI##elem_size(rt_m, arena_ptr, GetElementPtr(src, 1U)); \
+    auto e3 = UReadMVI##elem_size(rt_m, arena_ptr, GetElementPtr(src, 2U)); \
+    auto e4 = UReadMVI##elem_size(rt_m, arena_ptr, GetElementPtr(src, 3U)); \
+    return TQuad<decltype(e1)>{e1, e2, e3, e4}; \
+  }
+
+MAKE_LD1_QUAD(8)
+MAKE_LD1_QUAD(16)
+MAKE_LD1_QUAD(32)
+MAKE_LD1_QUAD(64)
+
