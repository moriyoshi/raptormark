+MAKE_LD1_MULTI_POSTINDEX(TRIPLE, 8)
+MAKE_LD1_MULTI_POSTINDEX(TRIPLE, 16)
+MAKE_LD1_MULTI_POSTINDEX(TRIPLE, 32)
+MAKE_LD1_MULTI_POSTINDEX(TRIPLE, 64)
+MAKE_LD1_MULTI_POSTINDEX(QUAD, 8)
+MAKE_LD1_MULTI_POSTINDEX(QUAD, 16)
