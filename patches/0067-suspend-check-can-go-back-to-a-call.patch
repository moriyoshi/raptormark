+++ b/backend/remill/include/remill/BC/TraceLifter.h
@@ -435,6 +435,10 @@
   // The `__ecv_unwinding` wasm global (address space 1) the suspend check reads,
   // in place of calling `_ecv_suspended`. Declared into the module on first use.
   llvm::GlobalVariable *GetOrCreateUnwindingGlobal();
+  // `_ecv_suspended`, for the ECV_SUSPEND_VIA_CALL form (patch 0067). Declared
+  // into the module on first use: after 0059 nothing else references it, so the
+  // declaration is not guaranteed to be there.
+  llvm::Function *GetOrDeclareSuspendedFn(llvm::Value *runtime_ptr);
 
   // Any i32 wasm global (address space 1) ecvisor's C shim defines. Declared
   // into the module on first use.
--- a/backend/remill/lib/BC/ForkEmulation.cpp
+++ b/backend/remill/lib/BC/ForkEmulation.cpp
