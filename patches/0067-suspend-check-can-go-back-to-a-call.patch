+// Whether to emit the suspend check as a CALL to `_ecv_suspended` instead of a
+// read of the `__ecv_unwinding` wasm global.
+//
+// Off by default: the global read is why patch 0059 exists. It is turned on for
+// the `wasix` profile, whose loader refuses a module that imports a GLOBAL from
+// `env` -- see patch 0067's header.
+//
+// Read ONCE. There are tens of thousands of suspend-check sites in a real lift.
+static bool SuspendCheckViaCall() {
+  static const bool via_call = getenv("ECV_SUSPEND_VIA_CALL") != nullptr;
+  return via_call;
+}
+
+// `_ecv_suspended`, declared into this module if it is not already there.
+//
+// It usually is not: after 0059 the suspend check was its only caller, so the
+// declaration went with it. The parameter type comes from the value the caller
+// is about to pass, so this cannot disagree with the call it is built for.
+llvm::Function *TraceLifter::Impl::GetOrDeclareSuspendedFn(llvm::Value *runtime_ptr) {
+  static constexpr const char *kName = "_ecv_suspended";
+  if (auto *f = module->getFunction(kName)) {
+    return f;
+  }
+  auto *fty = llvm::FunctionType::get(llvm::Type::getInt8Ty(context),
+                                      {runtime_ptr->getType()}, /*isVarArg=*/false);
+  return llvm::Function::Create(fty, llvm::GlobalValue::ExternalLinkage, kName, module);
+}
+
