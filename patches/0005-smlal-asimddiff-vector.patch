+// SMLAL{2}  <Vd>.<Ta>, <Vn>.<Tb>, <Vm>.<Tb>  -- signed multiply-accumulate long.
+// Like SADDL (widening) but multiplies the two narrow source elements and ADDS
+// into the wide destination accumulator (read via the kActionReadWrite dst, as
+// ADDHN2 does). The "2" variant consumes the high-half source elements.
+namespace {
+#define MAKE_SMLAL(s_esize, d_esize) \
+  template <typename D, typename S> \
+  DEF_SEM_T(SMLAL_##s_esize, D dst, S srcn, S srcm) { \
+    auto srcn_v = SReadVI##s_esize(srcn); \
+    auto srcm_v = SReadVI##s_esize(srcm); \
+    D res = SReadVI##d_esize(dst); \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(res); i++) { \
+      res[i] += int##d_esize##_t(srcn_v[i]) * int##d_esize##_t(srcm_v[i]); \
+    } \
+    return res; \
+  } \
+  template <typename D, typename S> \
+  DEF_SEM_T(SMLAL2_##s_esize, D dst, S srcn, S srcm) { \
+    auto srcn_v = SReadVI##s_esize(srcn); \
+    auto srcm_v = SReadVI##s_esize(srcm); \
+    D res = SReadVI##d_esize(dst); \
+    auto res_len = GetVectorElemsNum(res); \
+    _Pragma("unroll") for (size_t i = 0; i < res_len; i++) { \
+      res[i] += int##d_esize##_t(srcn_v[i + res_len]) * int##d_esize##_t(srcm_v[i + res_len]); \
+    } \
+    return res; \
+  }
+
+MAKE_SMLAL(8, 16);
+MAKE_SMLAL(16, 32);
+MAKE_SMLAL(32, 64);
+
+#undef MAKE_SMLAL
+
+}  // namespace
+
+DEF_ISEL(SMLAL_ASIMDDIFF_L_8H8B) = SMLAL_8<VIi16v8, VIi8v8>;
+DEF_ISEL(SMLAL_ASIMDDIFF_L_4S4H) = SMLAL_16<VIi32v4, VIi16v4>;
+DEF_ISEL(SMLAL_ASIMDDIFF_L_2D2S) = SMLAL_32<VIi64v2, VIi32v2>;
+
+DEF_ISEL(SMLAL_ASIMDDIFF_L_8H16B) = SMLAL2_8<VIi16v8, VIi8v16>;
+DEF_ISEL(SMLAL_ASIMDDIFF_L_4S8H) = SMLAL2_16<VIi32v4, VIi16v8>;
+DEF_ISEL(SMLAL_ASIMDDIFF_L_2D4S) = SMLAL2_32<VIi64v2, VIi32v4>;
