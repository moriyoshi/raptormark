 // FADD  <Vd>.<T>, <Vn>.<T>, <Vm>.<T>
+// FCM{EQ,GE,GT}: float compare producing a MASK, all ones or all zeros.
+//
+// Every form of these was a decode stub. postgres reaches the scalar single
+// form in `expanded_record_set_fields`, which is what plpgsql exercises, so
+// initdb stopped there once the extension loaded.
+//
+// Four shapes, one decoder each:
+//   ASIMDSAME  vector, register-register     <Vd>.<T>, <Vn>.<T>, <Vm>.<T>
+//   ASISDSAME  scalar, register-register     <V><d>, <V><n>, <V><m>
+//   ASIMDMISC  vector, against zero          <Vd>.<T>, <Vn>.<T>, #0.0
+//   ASISDMISC  scalar, against zero          <V><d>, <V><n>, #0.0
+//
+// The SCALAR destination is written through the smallest vector view rather
+// than kRegS/kRegD, for two reasons: the result is an integer mask and those
+// classes are float, and writing Sd/Dd architecturally zeroes the rest of Vd,
+// which a {mask, 0} vector write expresses exactly. There is no kReg1S, so the
+// single-precision scalar uses kReg2S with the upper lane written zero.
+static bool TryDecodeFCM_ASIMDSAME(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  if (data.sz && !data.Q) {
+    return false;  // 1D is unallocated
+  }
+  const uint64_t total_size = data.Q ? 128 : 64;
+  const uint64_t elem_size = data.sz ? 64 : 32;
+  AddArrangementSpecifier(inst, total_size, elem_size);
+  auto rclass = ArrangementRegClass(total_size, elem_size, true);
+  AddRegOperand(inst, kActionWrite, rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rm);
+  return true;
+}
+
+static bool TryDecodeFCM_ASISDSAME(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  auto rclass = data.sz ? kReg1D : kReg2S;
+  std::stringstream ss;
+  ss << inst.function << (data.sz ? "_D" : "_S");
+  inst.function = ss.str();
+  AddRegOperand(inst, kActionWrite, rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rm);
+  return true;
+}
+
+static bool TryDecodeFCM_ASIMDMISC_FZ(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  if (data.sz && !data.Q) {
+    return false;
+  }
+  const uint64_t total_size = data.Q ? 128 : 64;
+  const uint64_t elem_size = data.sz ? 64 : 32;
+  AddArrangementSpecifier(inst, total_size, elem_size);
+  auto rclass = ArrangementRegClass(total_size, elem_size, true);
+  AddRegOperand(inst, kActionWrite, rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rn);
+  return true;
+}
+
+static bool TryDecodeFCM_ASISDMISC_FZ(const InstData &data, Instruction &inst) {
+  inst.sema_func_arg_type = SemaFuncArgType::Nothing;
+  auto rclass = data.sz ? kReg1D : kReg2S;
+  std::stringstream ss;
+  ss << inst.function << (data.sz ? "_D" : "_S");
+  inst.function = ss.str();
+  AddRegOperand(inst, kActionWrite, rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rn);
+  return true;
+}
+
+bool TryDecodeFCMEQ_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) {
+  return TryDecodeFCM_ASIMDSAME(data, inst);
+}
