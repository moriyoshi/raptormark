diff --git a/backend/remill/lib/Arch/AArch64/Semantics/SIMD.cpp b/backend/remill/lib/Arch/AArch64/Semantics/SIMD.cpp
index f35c709..06ca8df 100644
--- a/backend/remill/lib/Arch/AArch64/Semantics/SIMD.cpp
+++ b/backend/remill/lib/Arch/AArch64/Semantics/SIMD.cpp
@@ -1374,6 +1374,80 @@ DEF_ISEL(FMUL_ASIMDSAME_ONLY_2S) = FMUL_V32<VIf32v2>;  // FMUL  <Vd>.<T>, <Vn>.<
 DEF_ISEL(FMUL_ASIMDSAME_ONLY_4S) = FMUL_V32<VIf32v4>;  // FMUL  <Vd>.<T>, <Vn>.<T>, <Vm>.<T>
 DEF_ISEL(FMUL_ASIMDSAME_ONLY_2D) = FMUL_V64<VIf64v2>;  // FMUL  <Vd>.<T>, <Vn>.<T>, <Vm>.<T>
 
+// FCM{EQ,GE,GT}: an all-ones / all-zeros mask per element.
+//
+// NaN must compare FALSE for all three, which C++'s ==, >= and > already do --
+// the reference run confirms `fcmgt s (NaN>1)` and `fcmeq s (NaN==NaN)` are
+// both 00000000. Written as a mask rather than a bool because that is what the
+// caller consumes: postgres does `fcmgt` then `fmov w0, s31` and reads the bits.
+namespace {
+
+#define MAKE_FCM_VECTOR(name, op, bits) \
+  template <typename S, typename D> \
+  DEF_SEM_T(name##_V##bits, S a, S b) { \
+    auto av = FReadVI##bits(a); \
+    auto bv = FReadVI##bits(b); \
+    D res{}; \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(av); i++) { \
+      res[i] = (av[i] op bv[i]) ? ~uint##bits##_t(0) : uint##bits##_t(0); \
+    } \
+    return res; \
+  } \
+  template <typename S, typename D> \
+  DEF_SEM_T(name##_VZ##bits, S a) { \
+    auto av = FReadVI##bits(a); \
+    D res{}; \
+    _Pragma("unroll") for (size_t i = 0; i < GetVectorElemsNum(av); i++) { \
+      res[i] = (av[i] op float##bits##_t(0)) ? ~uint##bits##_t(0) : uint##bits##_t(0); \
+    } \
+    return res; \
+  }
+
+MAKE_FCM_VECTOR(FCMEQ, ==, 32)
+MAKE_FCM_VECTOR(FCMEQ, ==, 64)
+MAKE_FCM_VECTOR(FCMGE, >=, 32)
+MAKE_FCM_VECTOR(FCMGE, >=, 64)
+MAKE_FCM_VECTOR(FCMGT, >, 32)
+MAKE_FCM_VECTOR(FCMGT, >, 64)
+
+#undef MAKE_FCM_VECTOR
+
+}  // namespace
