 std::string AArch64TraceManager::AddRestDisasmFunc(uint64_t addr) {
+  // raptormark: a target outside every code section is not liftable, and saying
+  // so is the caller's business, not a reason to kill the run.
+  //
+  // Some bytes always get decoded as instructions: a literal pool, alignment
+  // padding, or hand-written assembly that carries neither symbols nor CFI
+  // (OpenSSL's aarch64 routines are ~158 KB of exactly that, and no amount of
+  // symbol recovery describes them -- see internal/fuse/ehframe.go). Such a
+  // decode yields a `bl` to a nonsense address. Aborting there discards a lift
+  // of tens of thousands of real functions over one instruction that was never
+  // code.
+  //
+  // Returning empty lets TraceLifter treat the call as a nop, which is what the
+  // comment at its call site already says it intends for unliftable `bl`
+  // targets. The section bound below then keeps a synthetic function from
+  // running past the end of its own section into unrelated bytes.
+  uint64_t sec_end = 0;
+  for (auto &[_, code_section] : elf_obj.code_sections) {
+    if (addr >= code_section.vma && addr < code_section.vma + code_section.size) {
+      sec_end = code_section.vma + code_section.size;
+      break;
+    }
+  }
+  if (sec_end == 0) {
+    LOG(WARNING) << "[WARNING] branch target 0x" << std::hex << addr << std::dec
+                 << " is outside every code section; treating the call as a nop.";
+    return "";
+  }
+
   auto rest_fun_name = GetUniqueLiftedFuncName("_ecv_rest_fun", addr);
   auto upper_addr_1 = disasm_funcs.upper_bound(addr);
   auto upper_addr_2 = rest_disasm_funcs.upper_bound(addr);
