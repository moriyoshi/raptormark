+// Outer-phase accounting. decode+emit are ~4.5% of a lift and the WHOLE
+// instruction work-list loop is ~6.6%, so the cost is out here. Printed with
+// ECV_DECODE_STATS alongside the inner numbers.
+static std::chrono::steady_clock::time_point ecv_ph0;
+static double ecv_sem_s = 0, ecv_meta_s = 0, ecv_traceloop_s = 0, ecv_subseq_s = 0,
+              ecv_prepare_s = 0;
+#define ECV_PHASE_BEGIN() ecv_ph0 = std::chrono::steady_clock::now()
+#define ECV_PHASE_END(acc) \
+  acc += std::chrono::duration_cast<std::chrono::nanoseconds>( \
+             std::chrono::steady_clock::now() - ecv_ph0) \
+             .count() / 1e9
