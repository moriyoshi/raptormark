+  // Appends, in increasing address order, every BTI *jump* landing pad
+  // (`bti j` / `bti jc`) at a 4-byte step from `lo` in [lo, hi), stopping at the
+  // first `bti c` -- the next function entry -- or at the first unreadable word.
+  //
+  // This is the BTI landing-pad scan of the seeding block in `Impl::Lift`,
+  // hoisted behind an interface so a manager that can answer it from an index
+  // may do so. The default below IS that loop, so the answer is defined by the
+  // scan and an override is only allowed to be faster, never different.
+  //
+  // Why it is worth an interface: the scan runs once per lifted function and
+  // reads a word per 4-byte slot until it meets a `bti c`. A binary built
+  // WITHOUT branch protection has none -- busybox has 0 markers in 268,891
+  // instructions, bash 26 in 524,416 -- so the loop runs to the caller's
+  // 512 KiB cap every single time, re-reading the same megabytes for every
+  // function, and it cannot seed anything because a binary with no `bti c` has
+  // no `bti j` either. patches/0038 and 0040 made each read cheap; they did not
+  // make the reads fewer.
+  virtual void CollectBTIJumpPads(uint64_t lo, uint64_t hi, std::vector<uint64_t> *pads) {
+    for (uint64_t addr = lo; addr < hi; addr += 4) {
+      uint32_t word = 0;
+      if (!TryReadExecutableWord32(addr, &word)) {
+        break;  // ran off executable memory
+      }
+      if (word == 0xD503245FU) {
+        break;  // next function entry (bti c) -- stop before crossing into it
+      }
+      if (word == 0xD503249FU || word == 0xD50324DFU) {  // bti j / bti jc
+        pads->push_back(addr);
+      }
+    }
+  }
