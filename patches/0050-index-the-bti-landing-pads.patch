+uint64_t AArch64TraceManager::ContiguousCodeEnd(uint64_t addr) {
+  // The address at which a read starting from `addr` first leaves executable
+  // memory. `TryReadExecutableByte` accepts any byte inside any code range, and
+  // the base's word read is four of those, so a word straddling two ADJACENT
+  // sections is readable and the extent is the end of the maximal run of ranges
+  // that covers `addr` with no gap -- not the end of the one range holding it.
+  auto it = std::upper_bound(code_ranges.begin(), code_ranges.end(), addr,
+                             [](uint64_t a, const CodeRange &r) { return a < r.vma; });
+  if (it == code_ranges.begin()) {
+    return 0;  // before every range
+  }
+  --it;
+  uint64_t end = it->vma + it->size;
+  if (addr >= end) {
+    return 0;  // in a gap between ranges: the very first read fails
+  }
+  for (++it; it != code_ranges.end() && it->vma <= end; ++it) {
+    end = std::max(end, static_cast<uint64_t>(it->vma + it->size));
+  }
+  return end;
+}
+
+void AArch64TraceManager::BuildBTIIndex() {
+  if (bti_index_built) {
+    return;
+  }
+  bti_index_built = true;
+  // One pass over the guest's executable bytes, recording where the landing
+  // pads are. The scan this replaces asked the same question once per lifted
+  // function over a 512 KiB window, so it re-read most of .text a few thousand
+  // times; the answer never changes, because the bytes never change.
+  for (const auto &r : code_ranges) {
+    const uint64_t end = r.vma + r.size;
+    for (uint64_t a = (r.vma + 3) & ~UINT64_C(3); a < end; a += 4) {
+      uint32_t word = 0;
+      // Read through the same path the scan used, so a word straddling two
+      // sections is seen exactly as the scan saw it.
+      if (!TryReadExecutableWord32(a, &word)) {
+        continue;
+      }
+      if (word == 0xD503245FU) {  // bti c
+        bti_c_vmas.push_back(a);
+      } else if (word == 0xD503249FU || word == 0xD50324DFU) {  // bti j / bti jc
+        bti_j_vmas.push_back(a);
+      }
+    }
+  }
+  // Ranges are sorted and are not expected to overlap, but neither is asserted
+  // anywhere, and a duplicate or an inversion would silently change the answer.
+  for (auto *v : {&bti_c_vmas, &bti_j_vmas}) {
+    std::sort(v->begin(), v->end());
+    v->erase(std::unique(v->begin(), v->end()), v->end());
+  }
+}
+
+void AArch64TraceManager::CollectBTIJumpPads(uint64_t lo, uint64_t hi, std::vector<uint64_t> *pads) {
+  // The index holds 4-byte-aligned addresses, which is the walk the base scan
+  // performs when `lo` is aligned -- always, since `lo` is a trace address plus
+  // 4 and aarch64 instructions are 4-aligned. If it ever is not, defer to the
+  // scan rather than answer a slightly different question.
+  if ((lo & 3) != 0) {
+    TraceManager::CollectBTIJumpPads(lo, hi, pads);
+    return;
+  }
+  BuildBTIIndex();
+
+  // Reproduce the scan's two stopping conditions as one exclusive bound.
+  uint64_t limit = hi;
+  const uint64_t code_end = ContiguousCodeEnd(lo);
+  if (code_end < lo + 4) {
+    return;  // the first read already fails
+  }
+  // The last readable word starts at code_end - 4, so the exclusive bound is
+  // code_end - 3.
+  limit = std::min(limit, code_end - 3);
+  const auto next_c = std::lower_bound(bti_c_vmas.begin(), bti_c_vmas.end(), lo);
+  if (next_c != bti_c_vmas.end()) {
+    limit = std::min(limit, *next_c);  // stop BEFORE the next function entry
+  }
+
+  for (auto it = std::lower_bound(bti_j_vmas.begin(), bti_j_vmas.end(), lo);
+       it != bti_j_vmas.end() && *it < limit; ++it) {
+    pads->push_back(*it);
+  }
+}
