diff --git a/runtime/VmIntrinsics.cpp b/runtime/VmIntrinsics.cpp
index d5c0ced..941acfe 100644
--- a/runtime/VmIntrinsics.cpp
+++ b/runtime/VmIntrinsics.cpp
@@ -342,8 +342,41 @@ extern "C" uint8_t _ecv_suspended(RuntimeManager &rt_m) {
 // ecvisor defines its own in runtime/cshim/ecv_globals.c; the two runtimes are
 // linked separately and never together, so there is no duplicate symbol.
 __attribute__((address_space(1))) int __ecv_unwinding;
+
+// The call-history globals the inlined fast path reads (patch 0060), for the
+// same reason: the codegen emits them unconditionally under --fork_emulation and
+// an undefined symbol breaks this link. Patch 0059 learned that the hard way --
+// `TestUpstreamRuntime` and `TestFusedDynamicProgram` both failed with
+// `undefined symbol: __ecv_unwinding` -- so 0060 ships its definitions with it.
+//
+// ZERO IS THE CORRECT VALUE HERE, not merely a safe one. The fast path is taken
+// only when `len < cap`, and this runtime never sets `cap`,
+// so `0 < 0` is false and every call takes the SLOW arm -- the original
+// `_ecv_save_call_history` / `_ecv_func_epilogue` defined above. The upstream
+// runtime therefore keeps its existing behaviour with no further change, purely
+// because a zero-initialised capacity means "no room".
+__attribute__((address_space(1))) int __ecv_ch_base;
+__attribute__((address_space(1))) int __ecv_ch_len;
+__attribute__((address_space(1))) int __ecv_ch_cap;
+// `__ecv_slow` is GONE from the emitted condition -- a zero capacity says the
+// same thing in one fewer global read per site. Kept defined so an object built
+// against the older patch still links.
+__attribute__((address_space(1))) int __ecv_slow;
 #endif
 
+// The inline-capable call-history entry points, for the same link-safety reason
+// as everything above: a module built with `--inline-call-history` names them on
+// its slow arm, and an undefined symbol breaks this link. This runtime never
+// takes the inline path (its capacity stays zero), so they are the originals.
+extern "C" void _ecv_save_call_history_ic(State &state, RuntimeManager &rt_m, uint64_t func_addr,
+                                          uint64_t ret_addr) {
+  _ecv_save_call_history(state, rt_m, func_addr, ret_addr);
+}
+
+extern "C" void _ecv_func_epilogue_ic(State &state, RuntimeManager &rt_m) {
+  _ecv_func_epilogue(state, rt_m);
+}
+
 extern "C" void _ecv_unreached(uint64_t value) {
   elfconv_runtime_error("You must not reach this point. value: 0x%llx\n", value);
 }
