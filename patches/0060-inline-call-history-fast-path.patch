+// Declares one of ecvisor's inline-capable call-history entry points on first
+// use. They are not in remill's intrinsic table -- they exist only for modules
+// built with `--inline-call-history`, and only the slow arm calls them.
+llvm::Function *TraceLifter::Impl::EcvRuntimeFn(const char *name,
+                                                llvm::ArrayRef<llvm::Type *> params) {
+  if (auto *f = module->getFunction(name)) {
+    return f;
+  }
+  auto *ty = llvm::FunctionType::get(llvm::Type::getVoidTy(context), params, false);
+  return llvm::Function::Create(ty, llvm::GlobalValue::ExternalLinkage, name, module);
+}
+
+// Any i32 wasm global ecvisor's C shim defines (runtime/cshim/ecv_globals.c).
+llvm::GlobalVariable *TraceLifter::Impl::GetOrCreateEcvI32Global(const char *name) {
+  if (auto *g = module->getNamedGlobal(name)) {
+    return g;
+  }
+  return new llvm::GlobalVariable(*module, llvm::Type::getInt32Ty(context),
+                                  /*isConstant=*/false, llvm::GlobalValue::ExternalLinkage,
+                                  /*Initializer=*/nullptr, name, /*InsertBefore=*/nullptr,
+                                  llvm::GlobalValue::NotThreadLocal, /*AddressSpace=*/1);
+}
+
+// Byte offset of `State.gpr.x[30].val` -- the guest link register.
+//
+// BAKED CONSTANT, and the reason it is safe to bake: `runtime/src/abi.rs` pins
+// the whole `State` layout with `const` assertions and carries one for THIS
+// offset naming this patch, so a layout change fails the ecvisor build with a
+// pointer back here rather than silently storing into the wrong register.
+//
+// offsetof(State, gpr) = 536; x[30] is the 31st 16-byte PaddedReg = 536 + 480;
+// `.val` is the second u64 of that pair = +8.
+static constexpr uint64_t kStateX30ValOffset = 536 + 30 * 16 + 8;
+
+// Inline the call-history push that `_ecv_save_call_history` used to do.
+//
+// WHY. It runs once per guest BL -- 32,972 call sites in a linked bash module --
+// and its hot-path body is a 16-byte store, a length bump and the x30 write.
+// Measured: removing both call-history hooks entirely is worth -31% on a
+// call-heavy guest and -4.7% on a realistic one, and trimming the Rust bodies
+// alone reached only -2.3% of that, so the remainder is the CALLS themselves.
+//
+// The fast arm is taken only when no per-call diagnostic is armed AND there is
+// room in the buffer; otherwise the original call runs and does exactly what it
+// always did, including growing the buffer. So this is a pure fast path: every
+// behaviour still has one owner, and a published capacity of zero restores the
+// old code path at run time for a differential.
+llvm::BasicBlock *TraceLifter::Impl::EmitCallHistoryPush(llvm::BasicBlock *block,
+                                                         uint64_t func_addr, uint64_t ret_addr) {
+  auto i32 = llvm::Type::getInt32Ty(context);
+  auto i64 = llvm::Type::getInt64Ty(context);
+  auto ptr = llvm::PointerType::get(i64, 0);
+
+  auto slow_bb = llvm::BasicBlock::Create(context, "L_ch_slow", func);
+  auto fast_bb = llvm::BasicBlock::Create(context, "L_ch_fast", func);
+  auto join_bb = llvm::BasicBlock::Create(context, "L_ch_join", func);
+  for (auto *bb : {slow_bb, fast_bb, join_bb}) {
+    virtual_regs_opt->bb_reg_info_node_map.insert(
+        {bb, new BBRegInfoNode(func, state_ptr, runtime_ptr)});
+  }
+
+  llvm::IRBuilder<> ir(block);
+  // ONE condition, not two. `__ecv_slow` used to be read here as well, to send
+  // diagnostics-armed runs down the slow arm -- but the runtime can express
+  // that by publishing a capacity of ZERO, and `len >= cap` already covers it.
+  // Folding the two saved a global read and a branch at every one of these
+  // sites (4,111 in a small guest), which is not a rounding error on an
+  // interpreter where cost tracks instruction count roughly 1:1.
+  auto len = ir.CreateLoad(i32, GetOrCreateEcvI32Global("__ecv_ch_len"), true);
+  auto cap = ir.CreateLoad(i32, GetOrCreateEcvI32Global("__ecv_ch_cap"), true);
+  auto need_slow = ir.CreateICmpSGE(len, cap);
+  ConditionalBranchWithSaveParents(slow_bb, fast_bb, need_slow, block);
+
+  {
+    llvm::IRBuilder<> sir(slow_bb);
+    sir.CreateCall(EcvRuntimeFn("_ecv_save_call_history_ic",
+                                {state_ptr->getType(), runtime_ptr->getType(), i64, i64}),
+                   {state_ptr, runtime_ptr, llvm::ConstantInt::get(i64, func_addr),
+                    llvm::ConstantInt::get(i64, ret_addr)});
+    DirectBranchWithSaveParents(join_bb, slow_bb);
+  }
+  {
+    llvm::IRBuilder<> fir(fast_bb);
+    auto base = fir.CreateLoad(i32, GetOrCreateEcvI32Global("__ecv_ch_base"), true);
+    // frame = base + len*16; {fun at +0, ret at +8} -- context.rs `Frame`.
+    auto off = fir.CreateAdd(base, fir.CreateMul(len, llvm::ConstantInt::get(i32, 16)));
+    fir.CreateStore(llvm::ConstantInt::get(i64, func_addr), fir.CreateIntToPtr(off, ptr));
+    fir.CreateStore(
+        llvm::ConstantInt::get(i64, ret_addr),
+        fir.CreateIntToPtr(fir.CreateAdd(off, llvm::ConstantInt::get(i32, 8)), ptr));
+    fir.CreateStore(fir.CreateAdd(len, llvm::ConstantInt::get(i32, 1)),
+                    GetOrCreateEcvI32Global("__ecv_ch_len"), true);
+    // x30 = ret_addr. SEMANTIC, not bookkeeping: fork_emulation's bl/blr
+    // lowering skips the CALL semantic that writes the link register, and code
+    // that reads x30 directly -- glibc's setjmp, PAC LR signing -- gets garbage
+    // without this. It is what fixed PostgreSQL's PG_TRY/PG_CATCH.
+    auto x30 = fir.CreateIntToPtr(
+        fir.CreateAdd(fir.CreatePtrToInt(state_ptr, i32),
+                      llvm::ConstantInt::get(i32, kStateX30ValOffset)),
+        ptr);
+    fir.CreateStore(llvm::ConstantInt::get(i64, ret_addr), x30);
+    DirectBranchWithSaveParents(join_bb, fast_bb);
+  }
+  return join_bb;
+}
+
+// The matching pop. Same diamond; the fast arm is one decrement.
+//
+// The `len == 0` guard sends an empty history to the slow arm, where Rust's
+// `pop()` returns None instead of underflowing. An inline decrement of zero
+// would wrap to 4294967295 and the next push would store 64 GiB past the buffer.
+llvm::BasicBlock *TraceLifter::Impl::EmitCallHistoryPop(llvm::BasicBlock *block) {
+  auto i32 = llvm::Type::getInt32Ty(context);
+
+  auto slow_bb = llvm::BasicBlock::Create(context, "L_chp_slow", func);
+  auto fast_bb = llvm::BasicBlock::Create(context, "L_chp_fast", func);
+  auto join_bb = llvm::BasicBlock::Create(context, "L_chp_join", func);
+  for (auto *bb : {slow_bb, fast_bb, join_bb}) {
+    virtual_regs_opt->bb_reg_info_node_map.insert(
+        {bb, new BBRegInfoNode(func, state_ptr, runtime_ptr)});
+  }
+
+  llvm::IRBuilder<> ir(block);
+  // `len == 0` alone, for the same reason as the push. The runtime keeps the
+  // published length at zero whenever the fast path must not run, so an empty
+  // history and a disabled fast path are the same test -- and it is the test
+  // that already had to be here, since an inline decrement of zero would wrap
+  // to 4294967295.
+  auto len = ir.CreateLoad(i32, GetOrCreateEcvI32Global("__ecv_ch_len"), true);
+  auto need_slow = ir.CreateICmpEQ(len, llvm::ConstantInt::get(i32, 0));
+  ConditionalBranchWithSaveParents(slow_bb, fast_bb, need_slow, block);
+
+  {
+    llvm::IRBuilder<> sir(slow_bb);
+    sir.CreateCall(EcvRuntimeFn("_ecv_func_epilogue_ic",
+                                {state_ptr->getType(), runtime_ptr->getType()}),
+                   {state_ptr, runtime_ptr});
+    DirectBranchWithSaveParents(join_bb, slow_bb);
+  }
+  {
+    llvm::IRBuilder<> fir(fast_bb);
+    fir.CreateStore(fir.CreateSub(len, llvm::ConstantInt::get(i32, 1)),
+                    GetOrCreateEcvI32Global("__ecv_ch_len"), true);
+    DirectBranchWithSaveParents(join_bb, fast_bb);
+  }
+  return join_bb;
+}
