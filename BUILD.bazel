# Repo root. Gazelle lives here; the artifacts live in //builder, //runtime and
# //cmd/raptormark.

load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix raptormark
# gazelle:exclude third_party
# gazelle:exclude web
# gazelle:exclude .agents-workspace
# gazelle:exclude _recovery
# tools/decode-oracle is a SEPARATE Go module, on purpose: it embeds QEMU's
# decodetree tables and is LGPL-2.1-or-later while raptormark is Apache-2.0.
# See go.work. Its BUILD files are generated by its own gazelle run so the two
# module boundaries stay visible here too.
# gazelle:exclude tools/decode-oracle
gazelle(name = "gazelle")

exports_files([
    "go.mod",
    "go.sum",
])
