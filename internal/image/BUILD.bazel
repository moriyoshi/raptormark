load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "image",
    srcs = [
        "image.go",
        "plugins.go",
        "shellscan.go",
    ],
    importpath = "raptormark/internal/image",
    visibility = ["//:__subpackages__"],
    # The shell parser. ❗ This `deps` entry is the half nothing guards:
    # `//internal/builder`'s TestEveryGoFileIsInItsBazelSrcs compares `srcs`
    # against the package's .go files and would name a missing one, but a missing
    # dep only shows up as a Bazel build failure -- which is why the Bazel gate
    # has to be run for this change, not just `go test`.
    deps = ["@cc_mvdan_sh_v3//syntax"],
)

go_test(
    name = "image_test",
    srcs = [
        "image_test.go",
        "plugindirs_test.go",
        "plugins_test.go",
        "shellscan_test.go",
    ],
    embed = [":image"],
    deps = ["@cc_mvdan_sh_v3//syntax"],
)
